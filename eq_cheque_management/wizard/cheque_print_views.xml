<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Cheque Print Wizard Form View -->
        <record id="view_cheque_print_form" model="ir.ui.view">
            <field name="name">cheque.print.form</field>
            <field name="model">cheque.print</field>
            <field name="arch" type="xml">
                <form string="Print Cheque">
                    <sheet>
                        <group>
                            <group>
                                <field name="cheque_book_id" options="{'no_create': True}" required="1"/>
                                <field name="cheque_number_id" options="{'no_create': True}"/>
                                <field name="account_number" readonly="1"/>
                                <field name="pay_to" required="1"/>
                                <field name="customer_id" options="{'no_create': False}"/>
                            </group>
                            <group>
                                <field name="cheque_date"/>
                                <field name="date_on_cheque"/>
                                <field name="amount" required="1"/>
                                <field name="currency_id" options="{'no_create': True}"/>
                                <field name="currency_symbol" readonly="1"/>
                                <field name="print_currency"/>
                                <field name="print_a_c_label"/>
                            </group>
                        </group>
                        <group>
                            <field name="amount_in_words" readonly="1"/>
                            <field name="amount_in_words_2" readonly="1"/>
                        </group>
                        <group>
                            <field name="show_preview" invisible="1"/>
                            <field name="report_preview" widget="html" invisible="not show_preview"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_print_preview" string="Preview" type="object" class="btn-primary"/>
                        <button name="action_hide_preview" string="Hide Preview" type="object" invisible="not show_preview"/>
                        <button name="action_print_cheque" string="Print Cheque" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>

