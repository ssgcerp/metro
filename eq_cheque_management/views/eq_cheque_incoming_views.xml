<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Incoming Cheque Form View -->
        <record id="view_eq_cheque_incoming_form" model="ir.ui.view">
            <field name="name">eq.cheque.incoming.form</field>
            <field name="model">eq.cheque.incoming</field>
            <field name="arch" type="xml">
                <form string="Incoming Cheque" create="1" edit="1">
                    <header>
                        <button name="action_register" string="Register" type="object" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_deposit" string="Deposit" type="object" class="btn-primary"
                                invisible="state != 'registered'"/>
                        <button name="action_done" string="Done" type="object" class="btn-primary"
                                invisible="state not in ('registered', 'deposited')"/>
                        <button name="action_bounce" string="Bounce" type="object" class="btn-secondary"
                                invisible="state != 'registered'"/>
                        <button name="action_return" string="Return" type="object" class="btn-secondary"
                                invisible="state != 'registered'"/>
                        <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"
                                invisible="state in ('done', 'cancel')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,registered,deposited,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object" name="action_view_journal_items" icon="fa-list">
                                <div class="o_stat_text">
                                    <span class="o_stat_value"><field name="move_line_count"/></span>
                                    <span class="o_stat_text">Journal Items</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1" invisible="name == 'New'"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Cheque Information">
                                <field name="cheque_number" required="1"/>
                                <field name="cheque_type" widget="radio" options="{'horizontal': true}"/>
                                <field name="partner_id" options="{'no_create': False}"/>
                                <field name="amount" required="1"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="journal_id" domain="[('type', '=', 'bank')]" options="{'no_create': True}"/>
                                <field name="debit_account_id" options="{'no_create': True}"/>
                                <field name="contract_id" options="{'no_create': True}" invisible="not context.get('show_contract')"/>
                            </group>
                            <group string="Dates">
                                <field name="cheque_date" required="1"/>
                                <field name="cheque_receive_date" required="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description" name="description">
                                <field name="description" placeholder="Enter description..."/>
                            </page>
                            <page string="Journal Items" name="journal_items">
                                <field name="move_line_ids" readonly="1">
                                    <list>
                                        <field name="date"/>
                                        <field name="account_id"/>
                                        <field name="partner_id"/>
                                        <field name="name"/>
                                        <field name="debit"/>
                                        <field name="credit"/>
                                        <field name="balance"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Incoming Cheque List View -->
        <record id="view_eq_cheque_incoming_list" model="ir.ui.view">
            <field name="name">eq.cheque.incoming.list</field>
            <field name="model">eq.cheque.incoming</field>
            <field name="arch" type="xml">
                <list string="Incoming Cheques" decoration-info="state == 'draft'" decoration-success="state == 'done'"
                      decoration-warning="state in ('registered', 'deposited')" decoration-danger="state in ('bounced', 'returned', 'cancel')">
                    <field name="name"/>
                    <field name="cheque_number"/>
                    <field name="partner_id"/>
                    <field name="amount" sum="Total"/>
                    <field name="cheque_date"/>
                    <field name="cheque_type"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'"
                           decoration-success="state == 'done'"
                           decoration-warning="state in ('registered', 'deposited')"
                           decoration-danger="state in ('bounced', 'returned', 'cancel')"/>
                    <field name="journal_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <!-- Incoming Cheque Search View -->
        <record id="view_eq_cheque_incoming_search" model="ir.ui.view">
            <field name="name">eq.cheque.incoming.search</field>
            <field name="model">eq.cheque.incoming</field>
            <field name="arch" type="xml">
                <search string="Incoming Cheques">
                    <field name="name"/>
                    <field name="cheque_number"/>
                    <field name="partner_id"/>
                    <field name="contract_id"/>
                    <field name="journal_id"/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Registered" name="registered" domain="[('state', '=', 'registered')]"/>
                    <filter string="Deposited" name="deposited" domain="[('state', '=', 'deposited')]"/>
                    <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                    <filter string="Bounced" name="bounced" domain="[('state', '=', 'bounced')]"/>
                    <filter string="Returned" name="returned" domain="[('state', '=', 'returned')]"/>
                    <separator/>
                    <filter string="CDC" name="cdc" domain="[('cheque_type', '=', 'cdc')]"/>
                    <filter string="PDC" name="pdc" domain="[('cheque_type', '=', 'pdc')]"/>
                    <separator/>
                    <group>
                        <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Cheque Type" name="group_cheque_type" context="{'group_by': 'cheque_type'}"/>
                        <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                        <filter string="Journal" name="group_journal" context="{'group_by': 'journal_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action for Incoming Cheques -->
        <record id="action_eq_cheque_incoming" model="ir.actions.act_window">
            <field name="name">Incoming Cheques</field>
            <field name="res_model">eq.cheque.incoming</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_draft': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first incoming cheque
                </p>
                <p>
                    Manage incoming cheques (CDC/PDC) with full accounting integration.
                </p>
            </field>
        </record>
    </data>
</odoo>

