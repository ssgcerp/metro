<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend Company Form View to include Cheque Configuration -->
        <record id="view_company_form_inherit_cheque_config" model="ir.ui.view">
            <field name="name">res.company.form.inherit.cheque.config</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='currency_id']" position="after">
                    <field name="cheque_config_id" invisible="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

