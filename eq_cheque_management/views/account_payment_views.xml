<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Inherit account.payment form view to add PDC fields -->
        <record id="view_account_payment_form_inherit_pdc" model="ir.ui.view">
            <field name="name">account.payment.form.inherit.pdc</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <!-- Add PDC fields after date field -->
                <xpath expr="//field[@name='date']" position="after">
                    <field name="effective_date"
                           invisible="payment_method_code not in ['pdc', 'pdc_in', 'pdc_out']"
                           required="payment_method_code in ['pdc', 'pdc_in', 'pdc_out']"
                           help="Effective date for Post Dated Cheque (PDC)"/>
                    <field name="bank_reference" 
                           readonly="state != 'draft'"
                           help="Bank reference number"/>
                    <field name="cheque_reference" 
                           readonly="state != 'draft'"
                           help="Cheque reference number"/>
                </xpath>
            </field>
        </record>

        <!-- Inherit account.payment search view to add PDC filter -->
        <record id="view_account_payment_search_inherit_pdc" model="ir.ui.view">
            <field name="name">account.payment.search.inherit.pdc</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_search"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='activities_overdue']" position="before">
                    <filter string="PDC To Process"
                            domain="[('payment_method_id.code', 'in', ['pdc', 'pdc_in', 'pdc_out']), ('state', '=', 'posted'), ('effective_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"
                            name="pdc_to_process"/>
                    <separator/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>

