<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Cheque Book List View -->
        <record id="view_cheque_book_list" model="ir.ui.view">
            <field name="name">cheque.book.list</field>
            <field name="model">cheque.book</field>
            <field name="arch" type="xml">
                <list string="Cheque Books">
                    <field name="name"/>
                    <field name="bank_id"/>
                    <field name="account_number"/>
                    <field name="total_leaves"/>
                    <field name="cheque_from"/>
                    <field name="cheque_to"/>
                    <field name="issued_cheques"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <!-- Cheque Book Form View -->
        <record id="view_cheque_book_form" model="ir.ui.view">
            <field name="name">cheque.book.form</field>
            <field name="model">cheque.book</field>
            <field name="arch" type="xml">
                <form string="Cheque Book">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Cheque Book Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="bank_id" options="{'no_create': True}"/>
                                <field name="account_number"/>
                                <field name="is_total_leaves_read_only" invisible="1"/>
                                <field name="total_leaves" readonly="is_total_leaves_read_only"/>
                                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            </group>
                            <group string="Cheque Numbers">
                                <field name="is_from_date_readonly" invisible="1"/>
                                <field name="is_to_date_readonly" invisible="1"/>
                                <field name="cheque_from" readonly="is_from_date_readonly"/>
                                <field name="cheque_to" readonly="1"/>
                                <field name="issued_cheques" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Cheque Leaves">
                                <field name="cheque_leaf_ids" readonly="1">
                                    <list>
                                        <field name="number"/>
                                        <field name="payee_name"/>
                                        <field name="pay_to"/>
                                        <field name="amount"/>
                                        <field name="date"/>
                                        <field name="is_used" widget="boolean_toggle"/>
                                        <field name="is_cancelled" widget="boolean_toggle"/>
                                        <field name="remark"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Cheque Book Action -->
        <record id="action_cheque_book" model="ir.actions.act_window">
            <field name="name">Cheque Books</field>
            <field name="res_model">cheque.book</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>

