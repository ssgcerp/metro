<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend AMC Contract Form View to include PDC Cheque Smart Buttons -->
        <record id="view_amc_contract_form_inherit_cheque" model="ir.ui.view">
            <field name="name">amc.contract.form.inherit.cheque</field>
            <field name="model">amc.contract</field>
            <field name="inherit_id" ref="amc_contracts.view_amc_contract_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button" type="object" name="action_view_incoming_cheques" icon="fa-money">
                        <div class="o_stat_text">
                            <span class="o_stat_value"><field name="incoming_cheque_count"/></span>
                            <span class="o_stat_text">Incoming PDC</span>
                        </div>
                    </button>
                    <button class="oe_stat_button" type="object" name="action_view_outgoing_cheques" icon="fa-money">
                        <div class="o_stat_text">
                            <span class="o_stat_value"><field name="outgoing_cheque_count"/></span>
                            <span class="o_stat_text">Outgoing PDC</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

