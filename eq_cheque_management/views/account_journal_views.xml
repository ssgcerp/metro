<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend Journal Form View to include Allow Cheque field -->
        <record id="view_account_journal_form_inherit_cheque" model="ir.ui.view">
            <field name="name">account.journal.form.inherit.cheque</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='type']" position="after">
                    <field name="allow_cheque"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

