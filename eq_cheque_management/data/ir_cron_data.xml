<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- PDC Auto Deposit Cron Job -->
        <record id="ir_cron_pdc_deposit" model="ir.cron">
            <field name="name">PDC Auto Deposit</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="state">code</field>
            <field name="code">env['eq.cheque.incoming'].enqueue_pdc_deposit_jobs(); env['eq.cheque.outgoing'].enqueue_pdc_deposit_jobs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

