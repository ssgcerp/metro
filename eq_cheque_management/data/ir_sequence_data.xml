<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Incoming Cheque Sequence -->
        <record id="seq_eq_cheque_incoming" model="ir.sequence">
            <field name="name">Incoming Cheque Sequence</field>
            <field name="code">eq.cheque.incoming</field>
            <field name="prefix">IN-</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="use_date_range">True</field>
        </record>

        <!-- Outgoing Cheque Sequence -->
        <record id="seq_eq_cheque_outgoing" model="ir.sequence">
            <field name="name">Outgoing Cheque Sequence</field>
            <field name="code">eq.cheque.outgoing</field>
            <field name="prefix">OUT-</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="use_date_range">True</field>
        </record>
    </data>
</odoo>

