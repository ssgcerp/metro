<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Payment Method for CDC (Current Date Cheque) - Inbound -->
        <record id="account_payment_method_cdc_in" model="account.payment.method">
            <field name="name">CDC</field>
            <field name="code">cdc</field>
            <field name="payment_type">inbound</field>
        </record>

        <!-- Payment Method for CDC (Current Date Cheque) - Outbound -->
        <record id="account_payment_method_cdc_out" model="account.payment.method">
            <field name="name">CDC</field>
            <field name="code">cdc</field>
            <field name="payment_type">outbound</field>
        </record>

        <!-- Payment Method for PDC (Post-Dated Cheque) - Inbound -->
        <record id="account_payment_method_pdc_in" model="account.payment.method">
            <field name="name">PDC</field>
            <field name="code">pdc</field>
            <field name="payment_type">inbound</field>
        </record>

        <!-- Payment Method for PDC (Post-Dated Cheque) - Outbound -->
        <record id="account_payment_method_pdc_out" model="account.payment.method">
            <field name="name">PDC</field>
            <field name="code">pdc</field>
            <field name="payment_type">outbound</field>
        </record>
    </data>
</odoo>
