<odoo>
    <record id="view_purchase_requisition_approval_wizard" model="ir.ui.view">
        <field name="name">purchase.requisition.approval.wizard.form</field>
        <field name="model">purchase.requisition.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="Approve / Decline Requisition">
                <group>
                    <field name="requisition_id" invisible="1"/>
                    <field name="remark" widget="text" placeholder="Enter remark" required="1"/>
                </group>
                <footer>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"/>
                    <button name="action_decline" string="Decline" type="object" class="btn-danger"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_requisition_approval_wizard" model="ir.actions.act_window">
        <field name="name">Approve Requisition</field>
        <field name="res_model">purchase.requisition.approval.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_purchase_requisition_approval_wizard"/>
        <field name="target">new</field>
    </record>
</odoo>
