<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Form view of project approval model -->
    <record id="project_approval_view_form" model="ir.ui.view">
        <field name="name">project.approval.view.form</field>
        <field name="model">project.approval</field>
        <field name="arch" type="xml">
            <form class="oe_form_configuration">
                <sheet>
                    <div class="oe_title oe_read_only">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="approve_boq_project"/>
                            <field name="boq_approver_ids"
                                   widget="many2many_tags"
                                   invisible="approve_boq_project == False"
                                   required="approve_boq_project == True"/>
                            <field name="number_of_hours_for_auto_approval_boq"/>
                        </group>
                        <group string="Material Requisition Approval">
                            <field name="approve_material_requisition"/>
                            <field name="material_requisition_approver_ids" invisible="approve_material_requisition == False"
                                   required="approve_material_requisition == True">
                            </field>
                          
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"
                           widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"
                           options="{'post_refresh': 'recipients'}"/>
                </div>
            </form>
        </field>
    </record>
    <record id="approval_group_form_view" model="ir.ui.view">
            <field name="name">approval_group_form.view</field>
            <field name="model">project.approval.group</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Approver Groups">
                    <group>
                        <group>
                            <field name="group_id"/>
                        </group>
                        <group>
                            <field name="sequence" invisible="1"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="approval_group_tree_view" model="ir.ui.view">
            <field name="name">project.approval.group.tree</field>
            <field name="model">project.approval.group</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <list>
                    <field name="group_id"/>
                    <field name="sequence" invisible="1"/>
                </list>
            </field>
        </record>
    <!-- Action for project approval model -->
    <record id="project_approval_action" model="ir.actions.act_window">
        <field name="name">Project Multi Approval</field>
        <field name="res_model">project.approval</field>
        <field name="view_mode">list,form</field>
        <field name="target">inline</field>
    </record>
    <!-- Menu item for project approval configuration -->
    <menuitem id="menu_project_approval_configuration" 
              name="Project Approval" 
              parent="project.menu_project_config"
              sequence="10"
              action="project_approval_action"/>

   
</odoo>
