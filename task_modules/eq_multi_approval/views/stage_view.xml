<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stage_master_form" model="ir.ui.view">
        <field name="name">stage.master.form</field>
        <field name="model">stage.master</field>
        <field name="inherit_id" ref="pragtech_ppc.stage_master_tree_view"/>
        <field name="arch" type="xml">
                <xpath expr="//tree" position="inside">
                    <field name="in_request"/>
                </xpath>
        </field>
    </record>
    <data>
        <record id="view_stage_master_form_in_request" model="ir.ui.view">
            <field name="name">stage.master.form.in.request</field>
            <field name="model">stage.master</field>
            <field name="inherit_id" ref="pragtech_ppc.stage_master_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='draft']" position="after">
                    <field name="in_request"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
