<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="social_post_kanban_inherit" model="ir.ui.view">
        <field name="name">social.post.kanban.inherit</field>
        <field name="model">social.post</field>
        <field name="inherit_id" ref="social.social_post_view_kanban"/>
        <field name="arch" type="xml">
            <!-- Find the kanban-box template -->
            <!-- Add project_image field to the kanban view -->
            <xpath expr="//templates" position="before">
                <field name="project_image"/>
            </xpath>
            
            <!-- Insert the image into the card -->
            <!-- Insert the image into the card -->
            <xpath expr="//t[@t-name='card']" position="inside">
                 <field name="project_image" widget="image" class="oe_avatar m-0" style="max-width: 50px; max-height: 50px; border-radius: 5px;"/>
            </xpath>
        </field>
    </record>
    <record id="social_post_calendar_view_inherit" model="ir.ui.view">
        <field name="name">social.post.calendar.inherit</field>
        <field name="model">social.post</field>
        <field name="inherit_id" ref="social.social_post_view_calendar"/>
        <field name="arch" type="xml">
            <xpath expr="//calendar" position="inside">
                <field name="project_id" filters="1"/>
                <field name="project_image" widget="image" options="{'size': [32, 32]}"/>
            </xpath>
        </field>
    </record>
    <record id="social_post_view_inherit" model="ir.ui.view">
        <field name="name">social.post.view.inherit</field>
        <field name="model">social.post</field>
        <field name="inherit_id" ref="social.social_post_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image_ids']" position="after">
                <field name="project_id"/>
            </xpath>
        </field>
    </record>
</odoo>
