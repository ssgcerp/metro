<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_project_task_inherited_custom" model="ir.ui.view">
            <field name="name">view.project.task.inherited.custom</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                        <field name="date_start"/>
                        <field name="date_end"/>
                </xpath>
                <xpath expr="//field[@name='state']" position="replace">
                    <field name="internal_state" widget="statusbar" options="{'clickable': '1'}" statusbar_visible="not_started,in_progress,submitted_for_approval,in_correction,re_working,in_submit"/>
                </xpath>
                <xpath expr="//form/header" position="inside">
                    <field name="has_social_media" invisible="1" />
                    <button name="action_post_on_social_media" 
                        string="Post on Social Media" 
                        type="object"
                        class="oe_highlight"
                        invisible = "has_social_media == False"
                    />
                    <button name="action_approve_social_media" type="object" string="Approve"
                        class="btn-primary" groups="custom_task_template.group_social_media_manager"
                        invisible = "internal_state not in ('in_submit','submitted_for_approval')"
                        />
                
                    <button name="action_approve_digital_marketing" type="object" string="Approve"
                        class="btn-success" groups="custom_task_template.group_digital_marketing_manager"
                        invisible = "internal_state not in ('in_submit','partially_approved','submitted_for_approval')"
                        />
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside"> 
                    <button type="object"
                            name="action_open_social_post"
                            class="oe_stat_button"
                            invisible="social_post_id == False">
                        <i class="o_button_icon fa fa-share-square"></i>
                        <div class="o_stat_info">
                            <span class="o_stat_text">SM Post</span>
                            <span class="o_stat_value">
                                <field name="social_post_id" invisible="1"/>
                                <field name="social_post_state"/>
                            </span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>    
        <record id="view_project_task_tree_inherit" model="ir.ui.view">
            <field name="name">project.task.tree.inherit</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_tree2"/>
            <field name="arch" type="xml">
                <!-- Add internal_state field to the tree view -->
                <xpath expr="//list" position="inside">
                    <field name="internal_state"/>
                </xpath>
            </field>
        </record>
        <record id="project.act_project_project_2_project_task_all" model="ir.actions.act_window">
            <field name="name">Tasks</field>
            <field name="res_model">project.task</field>
            <field name="view_mode">kanban,list,form,calendar,pivot,graph,activity</field>
            <field name="domain">[('project_id', '=', active_id), ('display_in_project', '=', True),('parent_id', '=', None)]</field>
            <field name="context">{
                'default_project_id': active_id,
                'show_project_update': True,
                'search_default_open_tasks': 1,
            }</field>
            <field name="search_view_id" ref="project.view_task_search_form"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No tasks found. Let's create one!
                </p>
                <p>
                    Keep track of the progress of your tasks from creation to completion.<br/>
                    Collaborate efficiently by chatting in real-time or via email.
                </p>
            </field>
        </record>
        <record id="project.action_view_all_task" model="ir.actions.act_window">
            <field name="name">All Tasks</field>
            <field name="res_model">project.task</field>
            <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
            <field name="domain">[('display_in_project', '=', True),('parent_id', '=', None)]</field>
            <field name="context">{'search_default_open_tasks': 1, 'default_user_ids': [(4, uid)]}</field>
            <field name="search_view_id" ref="project.view_task_search_form"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No tasks found. Let's create one!
                </p>
                <p>
                    Organize your tasks by dispatching them across the pipeline.<br/>
                    Collaborate efficiently by chatting in real-time or via email.
                </p>
            </field>
        </record>
        <record id="project.action_view_my_task" model="ir.actions.act_window">
            <field name="name">My Tasks</field>
            <field name="res_model">project.task</field>
            <field name="view_mode">kanban,list,form,calendar,pivot,graph,activity</field>
            <field name="context">{
                'search_default_open_tasks': 1,
                'all_task': 0,
                'default_user_ids': [(4, uid)],
            }</field>
            <field name="search_view_id" ref="project.view_task_search_form"/>
            <field name="domain">[('user_ids', 'in', uid),('parent_id', '=', None)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No tasks found. Let's create one!
                </p>
                <p>
                    Organize your tasks by dispatching them across the pipeline.<br/>
                    Collaborate efficiently by chatting in real-time or via email.
                </p>
            </field>
        </record>
        <record id="view_task_form2_inherit" model="ir.ui.view">
            <field name="name">view.task.form2.inherit</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='sub_tasks_page']/field[@name='child_ids']/list" position="attributes">
                   
                    <attribute name="open_form_view">False</attribute>
                </xpath>
                <xpath expr="//page[@name='sub_tasks_page']/field[@name='child_ids']/list" position="inside">
                    <button name="action_open_subtask_wizard" string="View" type="object" class="oe_highlight"/>
                </xpath>
                <xpath expr="//field[@name='stage_id']" position="replace">
                </xpath>
                <xpath expr="//field[@name='tag_ids']" position="after">
                    <field name="content_type_id"/>
                    <field name="content_pillar_id"/>
                    <field name="content_topic"/>
                </xpath>
            </field>
        </record>
        
    </data>
</odoo>
