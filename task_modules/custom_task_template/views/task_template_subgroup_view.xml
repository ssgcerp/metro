<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_task_template_subgroup_tree" model="ir.ui.view">
        <field name="name">task.template.sub.group.tree</field>
        <field name="model">task.template.sub.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="task_template_group_id"/>
            </list>
        </field>
    </record>
    <record id="view_task_template_group_form" model="ir.ui.view">
        <field name="name">task.template.group.form</field>
        <field name="model">task.template.sub.group</field>
        <field name="arch" type="xml">
            <form string="Task Template Sub Group">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="task_template_group_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_task_template_subgroup" model="ir.actions.act_window">
        <field name="name">Template Sub Group</field>
        <field name="res_model">task.template.sub.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Create and manage task template sub group here.</p>
        </field>
    </record>

    <menuitem id="menu_task_template_subgroup"
              name="Template Sub Group"
              parent="menu_task_settings"
              action="action_task_template_subgroup"
              sequence="30"/>
</odoo>
