<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_task_content_pillar_tree" model="ir.ui.view">
        <field name="name">task.content.pillar.tree</field>
        <field name="model">task.content.pillar</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Task Role Form View -->
    <record id="view_task_content_pillar_form" model="ir.ui.view">
        <field name="name">task.content.pillar.form</field>
        <field name="model">task.content.pillar</field>
        <field name="arch" type="xml">
            <form string="Content pillar">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_content_pillar" model="ir.actions.act_window">
        <field name="name">Content pillar</field>
        <field name="res_model">task.content.pillar</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Create and manage content pillar here.</p>
        </field>
    </record>


    <!-- Child Menus -->
    <menuitem id="menu_content_pillar"
              name="Content pillar"
              parent="menu_task_settings"
              action="action_content_pillar"
              sequence="50"/>
    <record id="menu_content_pillar_rule" model="ir.rule">
        <field name="name">Hide Menu if Social Module Not Installed</field>
        <field name="model_id" ref="base.model_ir_ui_menu"/>
        <field name="domain_force">[('id', '!=', ref('custom_task_template.menu_content_pillar'))]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="active" eval="not bool(ref('social.group_social_manager', raise_if_not_found=False))"/>
    </record>
</odoo>
