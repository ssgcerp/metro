<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_task_platform_tree" model="ir.ui.view">
        <field name="name">task.platform</field>
        <field name="model">task.platform</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Task platform Form View -->
    <record id="view_task_platform_form" model="ir.ui.view">
        <field name="name">task.platform.form</field>
        <field name="model">task.platform</field>
        <field name="arch" type="xml">
            <form string="Platform">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_task_platform" model="ir.actions.act_window">
        <field name="name">Platform</field>
        <field name="res_model">task.platform</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Create and manage platform here.</p>
        </field>
    </record>
 
    <menuitem id="menu_task_platform"
              name="Platform"
              parent="menu_task_settings"
              action="action_task_platform"
              sequence="40"/>
</odoo>
