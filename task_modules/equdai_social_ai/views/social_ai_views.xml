<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_post_form_inherit_ai" model="ir.ui.view">
        <field name="name">google.post.form.inherit.ai</field>
        <field name="model">google.post</field>
        <field name="inherit_id" ref="equdai_gmb.view_google_post_form"/>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='summary']" position="before">
                <button name="action_open_ai_wizard" 
                        string="✨ Generate with AI" 
                        type="object" 
                        class="btn-link text-primary"/>
            </xpath>
        </field>
    </record>
</odoo>
