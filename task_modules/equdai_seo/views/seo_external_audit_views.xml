<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seo_external_audit_form" model="ir.ui.view">
        <field name="name">seo.external.audit.form</field>
        <field name="model">seo.external.audit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_scan_page" string="Scan Now" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Page Name"/>
                        <h1><field name="name" placeholder="Home Page"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="url" placeholder="https://example.com" widget="url"/>
                            <field name="target_keyword" placeholder="e.g. Odoo Developer"/>
                        </group>
                        <group>
                            <field name="scan_date"/>
                            <field name="load_time"/>
                            <field name="status_code"/>
                        </group>
                    </group>
                    <group string="Analysis Results">
                        <group>
                            <field name="score" widget="percentpie" style="height: 100px; width: 100px;"/>
                        </group>
                        <group>
                            <field name="meta_title"/>
                            <field name="meta_description"/>
                            <field name="h1_tag"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detailed Report">
                            <field name="audit_notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_seo_external_audit_tree" model="ir.ui.view">
        <field name="name">seo.external.audit.list</field>
        <field name="model">seo.external.audit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="url"/>
                <field name="target_keyword"/>
                <field name="scan_date"/>
                <field name="score" widget="progressbar"/>
                <field name="load_time"/>
            </list>
        </field>
    </record>

    <record id="action_seo_external_audit" model="ir.actions.act_window">
        <field name="name">External Page Audits</field>
        <field name="res_model">seo.external.audit</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_seo_external_audit" parent="menu_equdai_seo_root" action="action_seo_external_audit" sequence="30"/>
</odoo>
