<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Site Views -->
    <record id="view_gsc_site_form" model="ir.ui.view">
        <field name="name">google.search.console.site.form</field>
        <field name="model">google.search.console.site</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_fetch_analytics_last_30_days" string="Fetch Last 30 Days" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" placeholder="My Website"/>
                        <field name="site_url" placeholder="sc-domain:example.com"/>
                        <field name="credentials_id"/>
                    </group>
                    <notebook>
                        <page string="Performance Data">
                            <field name="report_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="query"/>
                                    <field name="clicks"/>
                                    <field name="impressions"/>
                                    <field name="position"/>
                                    <field name="ctr" widget="percentage"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gsc_site_tree" model="ir.ui.view">
        <field name="name">google.search.console.site.list</field>
        <field name="model">google.search.console.site</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="site_url"/>
                <field name="credentials_id"/>
            </list>
        </field>
    </record>

    <!-- Report Analysis Views -->
    <record id="view_gsc_report_pivot" model="ir.ui.view">
        <field name="name">google.search.console.report.pivot</field>
        <field name="model">google.search.console.report</field>
        <field name="arch" type="xml">
            <pivot string="SEO Performance" sample="1">
                <field name="site_id" type="row"/>
                <field name="query" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="clicks" type="measure"/>
                <field name="impressions" type="measure"/>
                <field name="position" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_gsc_report_graph" model="ir.ui.view">
        <field name="name">google.search.console.report.graph</field>
        <field name="model">google.search.console.report</field>
        <field name="arch" type="xml">
            <graph string="SEO Performance" type="line" sample="1">
                <field name="date" interval="day"/>
                <field name="clicks" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_gsc_sites" model="ir.actions.act_window">
        <field name="name">GSC Sites</field>
        <field name="res_model">google.search.console.site</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_gsc_performance" model="ir.actions.act_window">
        <field name="name">SEO Performance</field>
        <field name="res_model">google.search.console.report</field>
        <field name="view_mode">pivot,graph,list</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_equdai_seo_root" name="Google SEO"/>
    <menuitem id="menu_gsc_sites" parent="menu_equdai_seo_root" action="action_gsc_sites" sequence="10"/>
    <menuitem id="menu_gsc_performance" parent="menu_equdai_seo_root" action="action_gsc_performance" sequence="20"/>

</odoo>
