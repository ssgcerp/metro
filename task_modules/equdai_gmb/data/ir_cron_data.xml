<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_sync_google_locations" model="ir.cron">
            <field name="name">Google Business: Sync Locations</field>
            <field name="model_id" ref="model_google_business_profile"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_locations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record id="ir_cron_fetch_google_reviews" model="ir.cron">
            <field name="name">Google Business: Fetch Reviews</field>
            <field name="model_id" ref="model_google_review"/>
            <field name="state">code</field>
            <field name="code">model._cron_fetch_reviews()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
        </record>
    </data>
</odoo>
