<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu -->
    <menuitem id="menu_google_business_root"
              name="Google Business"
              web_icon="equdai_gmb,static/description/icon.png"
              sequence="10"/>

    <!-- Configuration Menu -->
    <menuitem id="menu_google_configuration"
              name="Configuration"
              parent="menu_google_business_root"
              sequence="100"/>
              
    <menuitem id="menu_google_credentials"
              name="API Credentials"
              parent="menu_google_configuration"
              action="action_google_credentials"
              sequence="10"/>

    <!-- Business Profiles Menu -->
    <menuitem id="menu_google_business_profile"
              name="Businesses"
              parent="menu_google_business_root"
              action="action_google_business_profile"
              sequence="10"/>

    <!-- Reviews Menu -->
    <menuitem id="menu_google_reviews"
              name="Reviews"
              parent="menu_google_business_root"
              action="action_google_review"
              sequence="20"/>

    <!-- Posts Menu -->
    <menuitem id="menu_google_posts"
              name="Posts"
              parent="menu_google_business_root"
              action="action_google_post"
              sequence="30"/>

    <!-- Services Menu -->
    <menuitem id="menu_google_services"
              name="Services"
              parent="menu_google_business_root"
              action="action_google_service"
              sequence="40"/>

</odoo>
