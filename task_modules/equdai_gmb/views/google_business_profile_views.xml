<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_business_profile_form" model="ir.ui.view">
        <field name="name">google.business.profile.form</field>
        <field name="model">google.business.profile</field>
        <field name="arch" type="xml">
            <form string="Business Profile">
                <header>
                    <button name="action_sync_location_details" string="Sync Details" type="object" class="btn-secondary"/>
                    <button name="action_fetch_reviews" string="Fetch Reviews" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_google_review_from_profile)d" type="action" class="oe_stat_button" icon="fa-star">
                            <field name="average_rating" widget="statinfo" string="Rating"/>
                        </button>
                        <button name="%(action_google_review_from_profile)d" type="action" class="oe_stat_button" icon="fa-comments">
                            <field name="review_count" widget="statinfo" string="Reviews"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="store_code"/>
                            <field name="credentials_id"/>
                        </group>
                        <group>
                            <field name="phone_number"/>
                            <field name="website_url" widget="url"/>
                            <field name="google_place_id"/>
                            <field name="location_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Services">
                            <field name="service_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="price"/>
                                    <field name="currency_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Address">
                            <field name="address"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_google_business_profile_tree" model="ir.ui.view">
        <field name="name">google.business.profile.list</field>
        <field name="model">google.business.profile</field>
        <field name="arch" type="xml">
            <list string="Business Profiles">
                <field name="name"/>
                <field name="store_code"/>
                <field name="average_rating" widget="progressbar"/>
                <field name="review_count"/>
                <field name="credentials_id"/>
            </list>
        </field>
    </record>
    
    <record id="action_google_business_profile" model="ir.actions.act_window">
        <field name="name">Business Profiles</field>
        <field name="res_model">google.business.profile</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
