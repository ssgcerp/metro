<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_review_form" model="ir.ui.view">
        <field name="name">google.review.form</field>
        <field name="model">google.review</field>
        <field name="arch" type="xml">
            <form string="Google Review">
                <header>
                    <button name="action_post_reply" string="Post Reply" type="object" class="btn-primary" invisible="is_replied"/>
                    <field name="is_replied" widget="boolean_toggle" readonly="1"/>
                </header>
                <sheet>
                    <div class="d-flex">
                        <!-- Placeholder for image, simplified -->
                        <div class="ms-2">
                             <h3><field name="reviewer_name"/></h3>
                             <div>
                                <field name="rating" widget="priority"/>
                             </div>
                        </div>
                    </div>
                    <group>
                        <field name="profile_id"/>
                        <field name="create_time" readonly="1"/>
                    </group>
                    <separator string="Review"/>
                    <field name="comment" readonly="1"/>
                    
                    <separator string="My Reply"/>
                    <field name="reply_comment" readonly="is_replied"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_google_review_tree" model="ir.ui.view">
        <field name="name">google.review.list</field>
        <field name="model">google.review</field>
        <field name="arch" type="xml">
            <list string="Reviews" decoration-danger="numeric_rating &lt; 3" decoration-success="numeric_rating &gt;= 4">
                <field name="reviewer_name"/>
                <field name="rating"/>
                <field name="numeric_rating" column_invisible="True"/>
                <field name="create_time"/>
                <field name="profile_id"/>
                <field name="is_replied"/>
            </list>
        </field>
    </record>
    
    <record id="action_google_review" model="ir.actions.act_window">
        <field name="name">Google Reviews</field>
        <field name="res_model">google.review</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_google_review_from_profile" model="ir.actions.act_window">
        <field name="name">Reviews</field>
        <field name="res_model">google.review</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('profile_id', '=', active_id)]</field>
        <field name="context">{'default_profile_id': active_id}</field>
    </record>
</odoo>
