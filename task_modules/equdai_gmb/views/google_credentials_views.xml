<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_credentials_form" model="ir.ui.view">
        <field name="name">google.credentials.form</field>
        <field name="model">google.credentials</field>
        <field name="arch" type="xml">
            <form string="Google Business Credentials">
                <header>
                    <button name="action_authenticate" string="Authenticate with Google" type="object" class="btn-primary" invisible="state == 'authenticated'"/>
                    <button name="refresh_access_token" string="Refresh Token" type="object" invisible="state != 'authenticated'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Configuration">
                            <field name="name"/>
                            <field name="client_id"/>
                            <field name="client_secret" password="True"/>
                        </group>
                        <group string="OAuth Info">
                            <field name="redirect_uri" readonly="1"/>
                            <field name="refresh_token" password="True" readonly="1"/>
                            <field name="access_token" password="True" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info text-center" role="alert">
                         <strong>Setup:</strong> Create a project in <a href="https://console.cloud.google.com/" target="_blank">Google Cloud Console</a>.
                         Enable <strong>Google Business Profile API</strong>. Set the Redirect URI in Google Console to the one shown above.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_google_credentials_tree" model="ir.ui.view">
        <field name="name">google.credentials.list</field>
        <field name="model">google.credentials</field>
        <field name="arch" type="xml">
            <list string="Credentials">
                <field name="name"/>
                <field name="client_id"/>
                <field name="state" widget="badge" decoration-success="state == 'authenticated'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="action_google_credentials" model="ir.actions.act_window">
        <field name="name">Google Credentials</field>
        <field name="res_model">google.credentials</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
