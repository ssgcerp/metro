<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Project Configuration -->
        <record id="default_fc_project_config" model="fc.project.config">
            <field name="name">Default Project Configuration</field>
            <field name="active" eval="True"/>
            <field name="amc_prefix">AMC</field>
            <field name="amc_suffix"></field>
            <field name="amc_padding" eval="5"/>
            <field name="non_amc_prefix">PROJ</field>
            <field name="non_amc_suffix"></field>
            <field name="non_amc_padding" eval="5"/>
            <field name="next_number" eval="1"/>
            <field name="amc_format_text"></field>
            <field name="non_amc_format_text"></field>
            <field name="include_branch_code" eval="True"/>
            <field name="include_year" eval="True"/>
            <field name="profit_warning_threshold" eval="10.0"/>
            <field name="profit_danger_threshold" eval="5.0"/>
            <field name="cost_warning_threshold" eval="10.0"/>
            <field name="cost_danger_threshold" eval="20.0"/>
        </record>
    </data>
</odoo>
