<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Project Stage Form View -->
    <record id="view_fc_project_stage_form" model="ir.ui.view">
        <field name="name">fc.project.stage.form</field>
        <field name="model">fc.project.stage</field>
        <field name="arch" type="xml">
            <form string="Project Stage">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="is_default" widget="boolean_button" options='{"terminology": "default"}' invisible="not is_default"/>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Stage Name" readonly="is_default"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="sequence" widget="handle"/>
                            <field name="fold"/>
                            <field name="color" widget="color_picker"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_confirmed_stage" readonly="is_default"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="is_default" readonly="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <field name="description" placeholder="Description of the stage" readonly="is_default"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Project Stage Tree View -->
    <record id="view_fc_project_stage_tree" model="ir.ui.view">
        <field name="name">fc.project.stage.tree</field>
        <field name="model">fc.project.stage</field>
        <field name="arch" type="xml">
            <list string="Project Stages">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="is_confirmed_stage" widget="boolean_toggle"/>
                <field name="is_default"/>
                <field name="fold" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Action for Project Stages -->
    <record id="action_fc_project_stage" model="ir.actions.act_window">
        <field name="name">Project Stages</field>
        <field name="res_model">fc.project.stage</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No stages defined
            </p>
            <p>
                Configure project stages for managing project lifecycle.
            </p>
        </field>
    </record>

</odoo>
