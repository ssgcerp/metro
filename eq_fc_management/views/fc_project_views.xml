<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Removed stage header override here; the statusbar is placed in project_dashboard_views.xml -->

        <!-- Extend project list view to show project code and stage -->
        <record id="view_project_tree_fc_extension" model="ir.ui.view">
            <field name="name">project.project.list.stage.extension</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.view_project_project_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <filter string="Project Stage" name="groupby_project_stage" context="{'group_by': 'stage_id'}"
                            groups="project.group_project_stages"/>
                </xpath>
            </field>
        </record>

        <record id="view_project_tree_fc" model="ir.ui.view">
            <field name="name">project.project.tree.stage.extension</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.view_project"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="project_code" string="Project code"/>
                    <field name="stage_id" string="Project Stage"/>
                </xpath>
                <xpath expr="//field[@name='stage_id']" position="after">
                    <button name="action_view_dashboard" type="object" string="View Dashboard" class="oe_link"/>
                </xpath>
            </field>
        </record>

        <!-- Customize project quick create form -->
        <record id="view_project_quick_create_fc" model="ir.ui.view">
            <field name="name">project.project.quick.create.fc</field>
            <field name="model">project.project</field>
            <field name="inherit_id" eval="False"/>
            <field name="arch" type="xml">
                <form string="Create a Project" class="o_form_project_project">
                    <field name="user_id" invisible="1"/>
                    <group col="1" class="o_group">
                        <field name="name" required="1" placeholder="e.g. Office Party"/>
                        <field name="partner_id" string="Customer" widget="res_partner_many2one" options="{'no_create': False}" required="1"/>
                        <field name="company_id" string="Company" options="{'no_create': True}"/>
                        <field name="amc_contract_id" string="AMC Contract"
                               options="{'no_create': True, 'no_open': True}"
                               placeholder="Select AMC Contract"
                               domain="[('active','=',True), ('stage_id.is_confirmed_stage','=', True), ('customer_id','=', partner_id), ('branch_id','=', company_id)]"/>
                    </group>
                    <footer>
                        <button string="Create project" name="action_view_tasks" type="object" class="btn-primary o_open_tasks" data-hotkey="q"/>
                        <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_project_modal_fc" model="ir.ui.view">
            <field name="name">project.project.form.simplified.footer.fc</field>
            <field name="model">project.project</field>
            <field name="inherit_id" eval="False"/>
            <field name="arch" type="xml">
                <form string="Create a Project" class="o_form_project_project">
                    <field name="user_id" invisible="1"/>
                    <group col="1" class="o_group">
                        <field name="name" required="1" placeholder="e.g. Office Party"/>
                        <field name="partner_id" string="Customer" widget="res_partner_many2one" options="{'no_create': False}"/>
                        <field name="company_id" string="Company" options="{'no_create': True}"/>
                        <field name="amc_contract_id" string="AMC Contract"
                               options="{'no_create': True, 'no_open': True}"
                               placeholder="Select AMC Contract"
                               domain="[('active','=',True), ('stage_id.is_confirmed_stage','=', True), ('customer_id','=', partner_id), ('branch_id','=', company_id)]"/>
                    </group>
                    <footer>
                        <button string="Create project" name="action_view_tasks" type="object" class="btn-primary o_open_tasks" data-hotkey="q"/>
                        <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Ensure popup action uses customized view -->
        <record id="project.open_create_project" model="ir.actions.act_window">
            <field name="view_id" ref="eq_fc_management.view_project_modal_fc"/>
        </record>

        <!-- Kanban inheritance temporarily removed; awaiting exact kanban template structure from this DB -->
        
        <!-- List view inheritance temporarily removed; awaiting exact list (tree) view xmlid from this DB -->
    </data>
</odoo>