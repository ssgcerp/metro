<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Project Configuration Form View -->
    <record id="view_fc_project_config_form" model="ir.ui.view">
        <field name="name">fc.project.config.form</field>
        <field name="model">fc.project.config</field>
        <field name="arch" type="xml">
            <form string="Project Configuration">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Project Numbering Configuration"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="AMC Project Numbering" col="4">
                            <field name="amc_prefix" placeholder="AMC"/>
                            <field name="amc_suffix" placeholder=""/>
                            <field name="amc_padding"/>
                        </group>
                        
                        <group string="Non-AMC Project Numbering" col="4">
                            <field name="non_amc_prefix" placeholder="PROJ"/>
                            <field name="non_amc_suffix" placeholder=""/>
                            <field name="non_amc_padding"/>
                        </group>
                        
                        <group string="Common Sequence" col="4">
                            <field name="next_number"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Thresholds" name="thresholds">
                            <group>
                                <group string="Profit Thresholds">
                                    <field name="profit_warning_threshold" widget="percentage"/>
                                    <field name="profit_danger_threshold" widget="percentage"/>
                                </group>
                                <group string="Cost Overrun Thresholds">
                                    <field name="cost_warning_threshold" widget="percentage"/>
                                    <field name="cost_danger_threshold" widget="percentage"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    
                    <group>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Project Configuration Tree View -->
    <record id="view_fc_project_config_tree" model="ir.ui.view">
        <field name="name">fc.project.config.tree</field>
        <field name="model">fc.project.config</field>
        <field name="arch" type="xml">
                         <list string="Project Configurations">
                 <field name="name"/>
                 <field name="active" widget="boolean_toggle"/>
                 <field name="amc_prefix"/>
                 <field name="non_amc_prefix"/>
                 <field name="next_number"/>
             </list>
        </field>
    </record>

    <!-- Action for Project Configuration -->
    <record id="action_fc_project_config" model="ir.actions.act_window">
        <field name="name">Project Configuration</field>
        <field name="res_model">fc.project.config</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first project configuration
            </p>
            <p>
                Configure project numbering formats for AMC and non-AMC projects.
            </p>
        </field>
    </record>

</odoo>
