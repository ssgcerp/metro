<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Product Template Form View -->
        <record id="view_product_template_form_inherit_brand" model="ir.ui.view">
            <field name="name">product.template.form.inherit.brand</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <!-- First, update the original category field with radio widget and domain -->
                <xpath expr="//field[@name='categ_id']" position="attributes">
                    <attribute name="widget">radio</attribute>
                    <attribute name="options">{'horizontal': true}</attribute>
                    <attribute name="domain">[('product_type', '=', type)]</attribute>
                    <attribute name="context">{'default_product_type': type}</attribute>
                </xpath>
                
                <!-- Move the category field to appear right after product type field -->
                <xpath expr="//field[@name='type']" position="after">
                    <field name="categ_id" 
                           widget="radio" 
                           options="{'horizontal': true}"
                           domain="[('product_type', '=', type)]"
                           context="{'default_product_type': type}"/>
                    <field name="brand_id" placeholder="Select Primary Brand"/>
                </xpath>
                
                <!-- Hide the original category field (which is not after type) -->
                <xpath expr="//field[@name='categ_id'][1][not(preceding-sibling::field[@name='type'])]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                
                <!-- Add brand variants tab -->
                <xpath expr="//notebook" position="inside">
                    <page string="Brand Variants" name="brand_variants">
                        <field name="brand_variant_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="brand_id" required="1"/>
                                <field name="list_price" string="Sales Price"/>
                                <field name="stock_qty" string="Total Stock" readonly="1"/>
                                <field name="active"/>
                                <button name="action_open_stock_locations" 
                                        type="object" 
                                        icon="fa-list"
                                        string="Stock Locations"/>
                            </list>
                            <form>
                                <sheet>
                                    <group>
                                        <group>
                                            <field name="brand_id" required="1"/>
                                            <field name="sequence"/>
                                            <field name="active"/>
                                        </group>
                                        <group>
                                            <field name="list_price" string="Sales Price"/>
                                            <field name="stock_qty" string="Total Stock" readonly="1"/>
                                        </group>
                                    </group>
                                    <group>
                                        <field name="location_stock_ids" nolabel="1">
                                            <list string="Location Stock">
                                                <field name="location_id"/>
                                                <field name="quantity"/>
                                                <field name="reserved_quantity"/>
                                                <field name="available_quantity" readonly="1"/>
                                            </list>
                                        </field>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
        
        <!-- Inherit Product Template List View -->
        <record id="view_product_template_tree_inherit_brand" model="ir.ui.view">
            <field name="name">product.template.tree.inherit.brand</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='categ_id']" position="after">
                    <field name="brand_id" optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

