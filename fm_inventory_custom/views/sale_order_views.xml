<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Note: Sale order lines are typically embedded in the order form, so we only inherit the form view -->
        
        <!-- Inherit Sale Order Form View -->
        <record id="view_order_form_inherit_brand" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.brand</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="after">
                    <field name="brand_variant_id" 
                           domain="[('product_template_id', '=', product_id.product_tmpl_id)]"
                           options="{'no_open': True, 'no_create': True}"
                           context="{'default_product_template_id': product_id.product_tmpl_id}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

