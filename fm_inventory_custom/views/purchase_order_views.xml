<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Purchase Order Line Tree View -->
        <record id="view_purchase_order_line_tree_inherit_brand" model="ir.ui.view">
            <field name="name">purchase.order.line.tree.inherit.brand</field>
            <field name="model">purchase.order.line</field>
            <field name="inherit_id" ref="purchase.purchase_order_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="brand_variant_id" optional="show"/>
                </xpath>
            </field>
        </record>
        
        <!-- Inherit Purchase Order Form View -->
        <record id="view_purchase_order_form_inherit_brand" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.brand</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="after">
                    <field name="brand_variant_id" 
                           domain="[('product_template_id', '=', product_id.product_tmpl_id)]"
                           options="{'no_open': True, 'no_create': True}"
                           context="{'default_product_template_id': product_id.product_tmpl_id}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

