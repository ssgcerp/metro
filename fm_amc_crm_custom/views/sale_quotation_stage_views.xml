<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Action for Quotation Stages -->
        <record id="action_sale_quotation_stage" model="ir.actions.act_window">
            <field name="name">Quotation Stages</field>
            <field name="res_model">sale.quotation.stage</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first quotation stage
                </p>
                <p>
                    Quotation stages define the workflow for quotations. Each stage can have different behaviors and buttons.
                </p>
            </field>
        </record>

        <!-- Form View for Quotation Stage -->
        <record id="view_sale_quotation_stage_form" model="ir.ui.view">
            <field name="name">sale.quotation.stage.form</field>
            <field name="model">sale.quotation.stage</field>
            <field name="arch" type="xml">
                <form string="Quotation Stage">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="sequence"/>
                                <field name="color" widget="color_picker"/>
                                <field name="fold"/>
                            </group>
                            <group string="Behavior">
                                <field name="is_draft_stage"/>
                                <field name="is_locked_stage"/>
                                <field name="is_cancelled_stage"/>
                                <field name="is_confirmed_stage"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View for Quotation Stage -->
        <record id="view_sale_quotation_stage_tree" model="ir.ui.view">
            <field name="name">sale.quotation.stage.tree</field>
            <field name="model">sale.quotation.stage</field>
            <field name="arch" type="xml">
                <list string="Quotation Stages">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="color" widget="color_picker"/>
                    <field name="is_draft_stage"/>
                    <field name="is_locked_stage"/>
                    <field name="is_cancelled_stage"/>
                    <field name="is_confirmed_stage"/>
                    <field name="fold"/>
                </list>
            </field>
        </record>
    </data>
</odoo>

