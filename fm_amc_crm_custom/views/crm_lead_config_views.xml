<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Action for Lead Configuration -->
        <record id="action_crm_lead_config" model="ir.actions.act_window">
            <field name="name">Lead Configuration</field>
            <field name="res_model">crm.lead.config</field>
            <field name="view_mode">list,form</field>
            <field name="limit">1</field>
            <field name="context">{'search_default_active': 1}</field>
        </record>

        <!-- Form View for Lead Configuration -->
        <record id="view_crm_lead_config_form" model="ir.ui.view">
            <field name="name">crm.lead.config.form</field>
            <field name="model">crm.lead.config</field>
            <field name="arch" type="xml">
                <form string="Lead Configuration">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lead Number Format" name="lead_number_format">
                                <div class="oe_title">
                                    <h1>Lead Sequence Format Configuration</h1>
                                    <p>Configure how lead sequence numbers are generated.</p>
                                </div>
                                
                                <group>
                                    <group>
                                        <field name="prefix" placeholder="e.g., L"/>
                                        <field name="module_code" placeholder="e.g., L"/>
                                        <field name="separator" placeholder="e.g., /"/>
                                        <field name="padding_digits" placeholder="e.g., 4"/>
                                        <field name="next_number" placeholder="Leave empty for auto"/>
                                    </group>
                                    <group>
                                        <field name="use_branch_code"/>
                                        <field name="use_year"/>
                                    </group>
                                </group>
                                
                                <group>
                                    <group>
                                        <field name="format_text" 
                                               placeholder="e.g., {prefix}/{modulecode}/{branchcode}/{nextnumber}/{year}"/>
                                    </group>
                                </group>
                                <div class="alert alert-info" role="alert" style="margin-top: 10px;">
                                    <strong>Available Placeholders (case-insensitive):</strong><br/>
                                    <ul style="margin-top: 5px;">
                                        <li><code>{prefix}</code> - Prefix value (e.g., L)</li>
                                        <li><code>{modulecode}</code> - Module code (e.g., L)</li>
                                        <li><code>{branchcode}</code> - Branch code (e.g., FUJ)</li>
                                        <li><code>{nextnumber}</code> - Sequential number (padded based on Padding Digits, e.g., 0001)</li>
                                        <li><code>{year}</code> - Year (e.g., 2025)</li>
                                    </ul>
                                    <br/>
                                    <strong>Format Text Priority:</strong><br/>
                                    1. If "Format Text" is set, it will be used<br/>
                                    2. If empty, the standard format will be used based on checkboxes above<br/>
                                </div>
                                
                                <div class="alert alert-info" role="alert">
                                    <strong>Format Example:</strong><br/>
                                    If Prefix = "L", Module Code = "L", Branch Code = "FUJ", 
                                    Sequential = "0001", Year = "2025", Separator = "/"<br/>
                                    Result: <strong>L/L/FUJ/0001/2025</strong><br/>
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View for Lead Configuration -->
        <record id="view_crm_lead_config_tree" model="ir.ui.view">
            <field name="name">crm.lead.config.list</field>
            <field name="model">crm.lead.config</field>
            <field name="arch" type="xml">
                <list string="Lead Configurations">
                    <field name="name"/>
                    <field name="prefix"/>
                    <field name="module_code"/>
                    <field name="use_branch_code"/>
                    <field name="use_year"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
