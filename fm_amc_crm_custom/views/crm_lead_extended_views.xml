<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend CRM Lead/Opportunity Form View -->
        <record id="view_crm_lead_form_extended" model="ir.ui.view">
            <field name="name">crm.lead.form.extended</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <!-- Add lead_sequence and lead_number as the first fields -->
                <xpath expr="//field[@name='name']" position="before">
                    <h2 class="d-flex gap-2">
                        <field name="lead_sequence" readonly="1" invisible="lead_sequence == 'New'"/>
                    </h2>
                    <field name="lead_sequence" invisible="1"/>
                    <field name="lead_number" string="Lead Number"/>
                </xpath>
                <!-- Add fields after the contact information section -->
                <xpath expr="//field[@name='phone']" position="after">
                    <field name="sales_agent" string="Sales Agent"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

