<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Decline Wizard Form View -->
        <record id="view_sale_quotation_decline_wizard_form" model="ir.ui.view">
            <field name="name">sale.quotation.decline.wizard.form</field>
            <field name="model">sale.quotation.decline.wizard</field>
            <field name="arch" type="xml">
                <form string="Decline Quotation">
                    <sheet>
                        <group>
                            <field name="order_id" invisible="1"/>
                            <field name="reason" placeholder="Enter the reason for declining this quotation..." nolabel="1"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Decline" name="action_decline" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>

