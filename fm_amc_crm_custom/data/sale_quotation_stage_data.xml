<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Draft Stage -->
        <record id="sale_quotation_stage_draft" model="sale.quotation.stage">
            <field name="name">Draft</field>
            <field name="code">draft</field>
            <field name="sequence">10</field>
            <field name="is_draft_stage" eval="True"/>
            <field name="is_locked_stage" eval="False"/>
            <field name="is_cancelled_stage" eval="False"/>
            <field name="color">0</field>
        </record>
        
        <!-- Pending Approval Stage -->
        <record id="sale_quotation_stage_pending_approval" model="sale.quotation.stage">
            <field name="name">Pending Approval</field>
            <field name="code">pending_approval</field>
            <field name="sequence">20</field>
            <field name="is_draft_stage" eval="False"/>
            <field name="is_locked_stage" eval="False"/>
            <field name="is_cancelled_stage" eval="False"/>
            <field name="color">5</field>
        </record>
        
        <!-- Quotation Stage -->
        <record id="sale_quotation_stage_quotation" model="sale.quotation.stage">
            <field name="name">Quotation</field>
            <field name="code">quotation</field>
            <field name="sequence">30</field>
            <field name="is_draft_stage" eval="False"/>
            <field name="is_locked_stage" eval="False"/>
            <field name="is_cancelled_stage" eval="False"/>
            <field name="color">10</field>
        </record>
        
        <!-- Quotation Sent Stage -->
        <record id="sale_quotation_stage_quotation_sent" model="sale.quotation.stage">
            <field name="name">Quotation Sent</field>
            <field name="code">quotation_sent</field>
            <field name="sequence">40</field>
            <field name="is_draft_stage" eval="False"/>
            <field name="is_locked_stage" eval="False"/>
            <field name="is_cancelled_stage" eval="False"/>
            <field name="color">3</field>
        </record>
        
        <!-- Sales Order Stage -->
        <record id="sale_quotation_stage_sales_order" model="sale.quotation.stage">
            <field name="name">Sales Order</field>
            <field name="code">sales_order</field>
            <field name="sequence">50</field>
            <field name="is_draft_stage" eval="False"/>
            <field name="is_locked_stage" eval="True"/>
            <field name="is_cancelled_stage" eval="False"/>
            <field name="color">4</field>
        </record>
        
        <!-- Cancelled Stage -->
        <record id="sale_quotation_stage_cancelled" model="sale.quotation.stage">
            <field name="name">Cancelled</field>
            <field name="code">cancelled</field>
            <field name="sequence">60</field>
            <field name="is_draft_stage" eval="False"/>
            <field name="is_locked_stage" eval="True"/>
            <field name="is_cancelled_stage" eval="True"/>
            <field name="color">1</field>
        </record>
    </data>
</odoo>

