<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Partner Merge Wizard Form View -->
    <record id="view_partner_merge_wizard_form" model="ir.ui.view">
        <field name="name">eq.partner.merge.wizard.form</field>
        <field name="model">eq.partner.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Merge">
                <header>
                    <button name="action_find_duplicates" string="Find Duplicates" type="object" class="btn-secondary" invisible="partner_ids"/>
                    <button name="action_merge_partners" string="Merge Contacts" type="object" class="btn-primary" invisible="not partner_ids"/>
                    <button string="Skip these contacts" class="btn-secondary" invisible="not partner_ids" special="cancel"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" invisible="partner_ids"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span>MERGE THE FOLLOWING CONTACTS</span>
                        </h1>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="not partner_ids">
                        <p>Selected contacts will be merged together. All documents linked to one of these contacts will be redirected to the destination contact. You can remove contacts from this list to avoid merging them.</p>
                    </div>
                    <group>
                        <group>
                            <field name="duplicate_name" invisible="1"/>
                            <label for="primary_partner_id" string="Destination Contact" invisible="not partner_ids"/>
                            <field name="primary_partner_id" 
                                   invisible="not partner_ids"
                                   required="partner_ids"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   widget="many2one"
                                   placeholder="Select destination contact..."/>
                        </group>
                    </group>
                    <group invisible="not partner_ids">
                        <field name="partner_ids" nolabel="1" readonly="1" 
                               options="{'no_create': True, 'no_create_edit': True, 'no_open': True}">
                            <list string="Contacts to Merge" create="0" delete="0" editable="bottom">
                                <field name="id" string="ID"/>
                                <field name="name" string="Display Name"/>
                                <field name="email" string="Email"/>
                                <field name="is_company" string="Is a Company"/>
                                <field name="vat" string="Tax ID"/>
                                <field name="country_id" string="Country"/>
                            </list>
                        </field>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="partner_ids">
                        <p>Click "Find Duplicates" to search for duplicate partners.</p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Partner Merge Wizard List View (for listing duplicates) -->
    <record id="view_partner_merge_wizard_list" model="ir.ui.view">
        <field name="name">eq.partner.merge.wizard.list</field>
        <field name="model">eq.partner.merge.wizard</field>
        <field name="arch" type="xml">
            <list string="Duplicate Partners" create="0" delete="0" decoration-muted="not partner_ids">
                <field name="duplicate_name"/>
                <field name="partner_count"/>
                <field name="partner_ids" widget="many2many_tags" readonly="1"/>
                <field name="primary_partner_id" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_partner_merge_wizard_search" model="ir.ui.view">
        <field name="name">eq.partner.merge.wizard.search</field>
        <field name="model">eq.partner.merge.wizard</field>
        <field name="arch" type="xml">
            <search string="Duplicate Partners">
                <field name="duplicate_name"/>
                <field name="partner_ids"/>
            </search>
        </field>
    </record>

    <!-- Action for finding duplicates -->
    <record id="action_find_duplicates" model="ir.actions.server">
        <field name="name">Find Duplicates</field>
        <field name="model_id" ref="model_eq_partner_merge_wizard"/>
        <field name="binding_model_id" ref="model_eq_partner_merge_wizard"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = model.find_and_create_duplicates()
        </field>
    </record>
</odoo>

