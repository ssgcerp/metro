<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action to find and show duplicates -->
    <record id="action_partner_duplicate_merge" model="ir.actions.act_window">
        <field name="name">Merge Duplicate Customers</field>
        <field name="res_model">eq.partner.merge.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="domain">[]</field>
        <field name="context">{'default_duplicate_name': 'Searching for duplicates...'}</field>
    </record>

    <!-- Menu Item -->
    <menuitem
        id="menu_partner_duplicate_merge"
        name="Merge Duplicate Customers"
        parent="crm.crm_menu_config"
        action="action_partner_duplicate_merge"
        sequence="100"
        groups="base.group_user"
    />
</odoo>

