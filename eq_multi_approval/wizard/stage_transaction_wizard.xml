<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit the existing form view to modify it -->
        <record id="view_approval_wizard_form" model="ir.ui.view">
            <field name="name">approval.wizard.form</field>
            <field name="model">approval.wizard</field>
            <field name="inherit_id" ref="pragtech_purchase.approval_wizard_form_view_purchase"/> 
            <field name="arch" type="xml">
                <xpath expr="//form/sheet/group" position="inside">
                    <field name="stage_domain" invisible="1"/>
                </xpath>

                <field name="new_stage" position="attributes">
                    <attribute name="domain">[('id', 'in', stage_domain)]</attribute>
                </field>
            </field>
        </record>
    </data>
</odoo>
