<odoo>
    <record id="view_purchase_requisition_form_inherit" model="ir.ui.view">
        <field name="name">purchase.requisition.form.inherit</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="pragtech_purchase.purchase_requisition_form_view"/>
        <field name="arch" type="xml">
            <header>
                 <field name="approval_button_visible" invisible="1"/>

                <!-- Button to open approval wizard -->
                <button name="open_approval_wizard"
                        type="object"
                        string="Change Request Approval"
                        invisible="approval_button_visible"
                        class="oe_highlight"/>
                
            </header>
        </field>
    </record>
</odoo>
