<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record for stage.master with stage name "Request Approval" and in_request set to True -->
        <record id="stage_master_request_approval" model="stage.master">
            <field name="name">Request Approval</field>
            <field name="in_request">True</field>
        </record>

        <record id="stage_master_request_declined" model="stage.master">
            <field name="name">Request Declined</field>
            <field name="foreclosed">True</field>
        </record>
    </data>


</odoo>
