<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_unified_analytics_pivot" model="ir.ui.view">
        <field name="name">unified.social.analytics.pivot</field>
        <field name="model">unified.social.analytics</field>
        <field name="arch" type="xml">
            <pivot string="Cross-Platform Analytics" sample="1">
                <field name="date" interval="month" type="col"/>
                <field name="platform" type="row"/>
                <field name="impressions" type="measure"/>
                <field name="clicks" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_unified_analytics_graph" model="ir.ui.view">
        <field name="name">unified.social.analytics.graph</field>
        <field name="model">unified.social.analytics</field>
        <field name="arch" type="xml">
            <graph string="Performance Trends" type="line" sample="1">
                <field name="date" interval="day"/>
                <field name="impressions" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_social_analytics" model="ir.actions.act_window">
        <field name="name">Social Analytics</field>
        <field name="res_model">unified.social.analytics</field>
        <field name="view_mode">pivot,graph</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_social_analytics" 
              parent="equdai_gmb.menu_google_business_root" 
              action="action_social_analytics" 
              sequence="50"
              name="All Analytics"/>
</odoo>
