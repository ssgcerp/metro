<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Access Rules for AMC Contract From Existing Wizard -->
        <record id="access_amc_contract_from_existing_wizard_accountant" model="ir.model.access">
            <field name="name">amc.contract.from.existing.wizard.accountant</field>
            <field name="model_id" ref="model_amc_contract_from_existing_wizard"/>
            <field name="group_id" ref="account.group_account_user"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="access_amc_contract_from_existing_wizard_manager" model="ir.model.access">
            <field name="name">amc.contract.from.existing.wizard.manager</field>
            <field name="model_id" ref="model_amc_contract_from_existing_wizard"/>
            <field name="group_id" ref="account.group_account_manager"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>

