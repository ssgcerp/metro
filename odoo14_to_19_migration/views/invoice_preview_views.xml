<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Invoice Line Preview List View -->
    <record id="view_invoice_line_preview_list" model="ir.ui.view">
        <field name="name">odoo14.invoice.line.preview.list</field>
        <field name="model">odoo14.invoice.line.preview</field>
        <field name="arch" type="xml">
            <list default_order="sequence">
                <field name="product_name"/>
                <field name="name"/>
                <field name="quantity"/>
                <field name="price_unit"/>
                <field name="discount"/>
                <field name="tax_names"/>
                <field name="price_subtotal" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_invoice_preview_list" model="ir.ui.view">
        <field name="name">odoo14.invoice.preview.list</field>
        <field name="model">odoo14.invoice.preview</field>
        <field name="arch" type="xml">
            <list string="Invoice Preview" default_order="invoice_date desc">
                <field name="name"/>
                <field name="partner_name"/>
                <field name="invoice_type"/>
                <field name="invoice_date"/>
                <field name="date_due"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_name"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_invoice_preview_form" model="ir.ui.view">
        <field name="name">odoo14.invoice.preview.form</field>
        <field name="model">odoo14.invoice.preview</field>
        <field name="arch" type="xml">
            <form string="Invoice Preview from Odoo 14">
                <header>
                    <button name="action_previous" string="Previous" type="object" 
                            class="btn-secondary" icon="fa-arrow-left"/>
                    <button name="action_next" string="Next" type="object" 
                            class="btn-secondary" icon="fa-arrow-right"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" class="oe_inline"/>
                        </h1>
                        <field name="invoice_type" readonly="1" invisible="1"/>
                    </div>
                    
                    <group>
                        <group string="Customer/Vendor Information">
                            <field name="partner_name" readonly="1"/>
                            <field name="partner_address" readonly="1" widget="text"/>
                        </group>
                        <group string="Invoice Details">
                            <field name="invoice_date" readonly="1"/>
                            <field name="date_due" readonly="1"/>
                            <field name="journal_name" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Invoice Lines">
                            <field name="invoice_line_ids" readonly="1" nolabel="1" 
                                   context="{'default_invoice_preview_id': id}"/>
                        </page>
                        <page string="Summary">
                            <group>
                                <group string="Amounts">
                                    <field name="amount_untaxed" readonly="1"/>
                                    <field name="amount_tax" readonly="1"/>
                                    <field name="amount_total" readonly="1"/>
                                    <field name="currency_name" readonly="1"/>
                                </group>
                            </group>
                            <group string="Additional Information">
                                <field name="comment" readonly="1" widget="text"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_invoice_preview" model="ir.actions.act_window">
        <field name="name">Invoice Preview from Odoo 14</field>
        <field name="res_model">odoo14.invoice.preview</field>
        <field name="view_mode">list,form</field>
        <field name="target">new</field>
    </record>
</odoo>

