<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quotation_preview_form" model="ir.ui.view">
        <field name="name">odoo14.quotation.preview.form</field>
        <field name="model">odoo14.quotation.preview</field>
        <field name="arch" type="xml">
            <form string="Quotation Preview" create="0" delete="0">
                <header>
                    <button name="action_previous" string="Previous" type="object" 
                            class="btn-secondary" icon="fa-arrow-left"
                            invisible="current_index &lt;= 0"/>
                    <button name="action_next" string="Next" type="object" 
                            class="btn-secondary" icon="fa-arrow-right"
                            invisible="current_index &gt;= total_count - 1"/>
                    <field name="current_index" invisible="1"/>
                    <field name="total_count" invisible="1"/>
                    <field name="display_position" readonly="1" nolabel="1" invisible="not display_position"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="quotation_name"/>
                            <field name="partner_name"/>
                            <field name="date_order"/>
                            <field name="validity_date"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="pricelist_id"/>
                            <field name="payment_term_id"/>
                            <field name="amount_untaxed"/>
                            <field name="amount_tax"/>
                            <field name="amount_total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <field name="order_line_ids" nolabel="1">
                                <list string="Order Lines" create="0" delete="0">
                                    <field name="sequence" invisible="1"/>
                                    <field name="product_name"/>
                                    <field name="name"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom"/>
                                    <field name="price_unit"/>
                                    <field name="discount"/>
                                    <field name="price_subtotal"/>
                                    <field name="tax_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Custom Fields" invisible="not custom_fields_json">
                            <group>
                                <field name="custom_fields_json" widget="text" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Full Data (JSON)" invisible="not quotation_data_json">
                            <field name="quotation_data_json" widget="text" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

