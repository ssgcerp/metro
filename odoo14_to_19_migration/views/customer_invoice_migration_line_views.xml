<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard for Excel Upload -->
    <record id="view_customer_invoice_upload_wizard_form" model="ir.ui.view">
        <field name="name">customer.invoice.upload.wizard.form</field>
        <field name="model">customer.invoice.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Customer Invoice Excel">
                <group>
                    <field name="config_id" placeholder="Optional: Select configuration for later status checking"/>
                    <field name="excel_file" filename="excel_filename" required="1"/>
                </group>
                <footer>
                    <button string="Upload" name="action_upload" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_customer_invoice_upload_wizard" model="ir.actions.act_window">
        <field name="name">Upload Excel</field>
        <field name="res_model">customer.invoice.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Tree View -->
    <record id="view_customer_invoice_migration_line_tree" model="ir.ui.view">
        <field name="name">customer.invoice.migration.line.tree</field>
        <field name="model">customer.invoice.migration.line</field>
        <field name="arch" type="xml">
            <list string="Customer Invoice Migration" multi_edit="1" create="0">
                <field name="uploaded_invoice_number"/>
                <field name="voucher_number"/>
                <field name="invoice_partner_name"/>
                <field name="invoice_bill_date"/>
                <field name="due_date"/>
                <field name="excel_status"/>
                <field name="payment_status"/>
                <field name="company"/>
                <field name="quote_reference"/>
                <field name="in_system_invoice_number"/>
                <field name="status" widget="badge" 
                       decoration-success="status == 'migrated' or status == 'already_migrated'"
                       decoration-warning="status == 'pending_migration' or status == 'queued'"
                       decoration-danger="status == 'error' or status == 'not_found'"
                       decoration-info="status == 'migrating'"/>
                <field name="status_message" optional="hide"/>
                <field name="migration_date" optional="hide"/>
                <field name="odoo19_invoice_id" optional="hide" widget="many2one"/>
                <field name="odoo19_sale_order_id" optional="hide" widget="many2one"/>
                <button name="action_check_status" string="Check Status" type="object" 
                        class="btn-secondary" icon="fa-refresh"/>
                <button name="action_migrate" string="Migrate" type="object" 
                        class="btn-primary" icon="fa-download"
                        invisible="status != 'pending_migration'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_customer_invoice_migration_line_form" model="ir.ui.view">
        <field name="name">customer.invoice.migration.line.form</field>
        <field name="model">customer.invoice.migration.line</field>
        <field name="arch" type="xml">
            <form string="Customer Invoice Migration Line">
                <header>
                    <button name="action_open_upload_wizard" string="Upload Excel" type="object" 
                            class="oe_highlight" icon="fa-upload"/>
                    <button name="action_open_upload_wizard" string="Add Excel" type="object" 
                            class="btn-primary" icon="fa-plus"/>
                    <button name="action_check_status" string="Check Status" type="object" 
                            class="btn-secondary" icon="fa-refresh"/>
                    <button name="action_migrate" string="Migrate" type="object" 
                            class="btn-primary" icon="fa-download"
                            invisible="status != 'pending_migration' and status != 'queued'"/>
                    <field name="status" widget="statusbar" 
                           statusbar_visible="pending_migration,queued,migrating,migrated"/>
                </header>
                <sheet>
                    <group>
                        <group string="Invoice Information">
                            <field name="uploaded_invoice_number"/>
                            <field name="in_system_invoice_number"/>
                            <field name="config_id" required="1"/>
                        </group>
                        <group string="Migration Status">
                            <field name="status"/>
                            <field name="migration_date"/>
                            <field name="odoo19_invoice_id"/>
                            <field name="odoo19_sale_order_id"/>
                        </group>
                    </group>
                    <group string="Excel Data">
                        <group>
                            <field name="voucher_number"/>
                            <field name="invoice_partner_name"/>
                            <field name="invoice_bill_date"/>
                            <field name="due_date"/>
                        </group>
                        <group>
                            <field name="excel_status"/>
                            <field name="payment_status"/>
                            <field name="company"/>
                            <field name="quote_reference"/>
                        </group>
                    </group>
                    <group>
                        <field name="status_message" nolabel="1"/>
                        <field name="error_message" nolabel="1" invisible="not error_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_customer_invoice_migration_line_search" model="ir.ui.view">
        <field name="name">customer.invoice.migration.line.search</field>
        <field name="model">customer.invoice.migration.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="uploaded_invoice_number"/>
                <field name="voucher_number"/>
                <field name="invoice_partner_name"/>
                <field name="company"/>
                <field name="quote_reference"/>
                <field name="in_system_invoice_number"/>
                <field name="status"/>
                <filter name="pending" string="Pending Migration" domain="[('status', '=', 'pending_migration')]"/>
                <filter name="queued" string="Queued" domain="[('status', '=', 'queued')]"/>
                <filter name="already_migrated" string="Already Migrated" domain="[('status', '=', 'already_migrated')]"/>
                <filter name="migrated" string="Migrated" domain="[('status', '=', 'migrated')]"/>
                <filter name="not_found" string="Not Found" domain="[('status', '=', 'not_found')]"/>
                <filter name="error" string="Error" domain="[('status', '=', 'error')]"/>
                <separator/>
                <filter name="needs_action" string="Needs Action" domain="[('status', 'in', ['pending_migration', 'queued', 'not_found', 'error'])]"/>
            </search>
        </field>
    </record>
    
    <!-- Server Action for Upload Excel -->
    <record id="action_server_customer_invoice_upload_excel" model="ir.actions.server">
        <field name="name">Upload Excel</field>
        <field name="model_id" ref="model_customer_invoice_migration_line"/>
        <field name="binding_model_id" ref="model_customer_invoice_migration_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = env.ref('odoo14_to_19_migration.action_customer_invoice_upload_wizard').read()[0]
        </field>
    </record>
    
    <!-- Server Action for Bulk Migrate -->
    <record id="action_server_customer_invoice_bulk_migrate" model="ir.actions.server">
        <field name="name">Migrate Selected</field>
        <field name="model_id" ref="model_customer_invoice_migration_line"/>
        <field name="binding_model_id" ref="model_customer_invoice_migration_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_bulk_migrate()
else:
    raise UserError("Please select at least one invoice to migrate")
        </field>
    </record>

    <!-- Server Action for Start Queued Migration -->
    <record id="action_server_customer_invoice_start_queued" model="ir.actions.server">
        <field name="name">Start Queued Migration</field>
        <field name="model_id" ref="model_customer_invoice_migration_line"/>
        <field name="binding_model_id" ref="model_customer_invoice_migration_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_start_queued_migration()
else:
    raise UserError("Please select at least one queued invoice to start migration")
        </field>
    </record>

    <!-- Action -->
    <record id="action_migration_customer_invoice" model="ir.actions.act_window">
        <field name="name">Customer Invoice</field>
        <field name="res_model">customer.invoice.migration.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_customer_invoice_migration_line_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload Excel file to start migration
            </p>
            <p>
                Click <strong>"Upload Excel"</strong> or <strong>"Add Excel"</strong> from the <strong>Action menu (⋮)</strong> in the top right to import invoice numbers from Excel file.
                Excel should have columns: Number, Voucher Number, Invoice Partner Name, Invoice/Bill Date, Due Date, Status, Payment Status, Company, Quote Reference.
            </p>
        </field>
    </record>

</odoo>

