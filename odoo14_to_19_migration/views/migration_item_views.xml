<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_migration_item_list" model="ir.ui.view">
        <field name="name">odoo14.migration.item.list</field>
        <field name="model">odoo14.migration.item</field>
        <field name="arch" type="xml">
            <list string="Migration Items" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="display_name" readonly="1"/>
                <field name="model_name" invisible="1"/>
                <field name="total_count" readonly="1" sum="Total"/>
                <field name="migrated_count" readonly="1" sum="Total"/>
                <field name="is_checked" readonly="1"/>
                <field name="last_check_date" readonly="1"/>
            </list>
        </field>
    </record>
</odoo>

