<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_preview_form" model="ir.ui.view">
        <field name="name">odoo14.employee.preview.form</field>
        <field name="model">odoo14.employee.preview</field>
        <field name="arch" type="xml">
            <form string="Employee Preview" create="0" delete="0">
                <header>
                    <button name="action_previous" string="Previous" type="object" 
                            class="btn-secondary" icon="fa-arrow-left"
                            invisible="current_index &lt;= 0"/>
                    <button name="action_next" string="Next" type="object" 
                            class="btn-secondary" icon="fa-arrow-right"
                            invisible="current_index &gt;= total_count - 1"/>
                    <field name="current_index" invisible="1"/>
                    <field name="total_count" invisible="1"/>
                    <field name="display_position" readonly="1" nolabel="1" invisible="not display_position"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_name"/>
                            <field name="employee_work_email"/>
                            <field name="employee_work_phone"/>
                            <field name="employee_mobile_phone"/>
                            <field name="employee_active"/>
                        </group>
                        <group>
                            <field name="employee_job"/>
                            <field name="employee_department"/>
                            <field name="employee_company"/>
                            <field name="employee_user"/>
                            <field name="employee_image" widget="image" class="oe_avatar" 
                                   options="{'preview_image': 'employee_image', 'size': [90, 90]}"/>
                        </group>
                    </group>
                    <group string="Full Employee Data (JSON) - Shows All Fields Including Custom Fields" invisible="not employee_data_json">
                        <field name="employee_data_json" widget="text" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
