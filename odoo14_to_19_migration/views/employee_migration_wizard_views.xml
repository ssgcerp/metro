<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_migration_wizard_form" model="ir.ui.view">
        <field name="name">odoo14.employee.migration.wizard.form</field>
        <field name="model">odoo14.employee.migration.wizard</field>
        <field name="arch" type="xml">
            <form string="Employee Migration">
                <group>
                    <field name="config_id" options="{'no_create': True, 'no_create_edit': True}" 
                           domain="[]" required="1"/>
                </group>
                
                <separator string="Migration Items"/>
                
                <!-- Employees Section -->
                <group>
                    <label for="employees_count" string="Employees"/>
                    <group>
                        <button name="action_check_employees" string="Check" type="object" 
                                class="btn-primary" icon="fa-search"/>
                        <button name="action_preview_employees" string="Preview" type="object" 
                                class="btn-secondary" icon="fa-eye"
                                invisible="employees_count &lt;= 0"/>
                        <button name="action_migrate_employees" string="Migrate" type="object" 
                                class="btn-primary" icon="fa-download"
                                invisible="employees_count &lt;= 0 or (is_migrating and employees_migrated &gt;= employees_count)"/>
                        <button name="action_migrate_employees" string="Continue Migration" type="object" 
                                class="btn-primary" icon="fa-play"
                                invisible="employees_count &lt;= 0 or not is_migrating or employees_migrated &gt;= employees_count"/>
                        <button name="action_refresh_view" string="Refresh" type="object" 
                                class="btn-secondary" icon="fa-refresh"
                                invisible="not is_migrating"/>
                    </group>
                    <group>
                        <label for="employees_count" string="Total count:"/>
                        <field name="employees_count" readonly="1" nolabel="1" widget="integer"/>
                        <label for="employees_migrated" string="Migrated Count:"/>
                        <field name="employees_migrated" readonly="1" nolabel="1" widget="integer" 
                               class="text-success" style="font-weight: bold; font-size: 18px; color: #28a745;"/>
                        <label for="employees_progress" string="Progress:" invisible="employees_count &lt;= 0"/>
                        <field name="employees_progress" widget="progressbar" readonly="1" nolabel="1" 
                               invisible="employees_count &lt;= 0" 
                               options="{'max_value': 100, 'editable': false}"
                               style="width: 100%; height: 25px;"/>
                        <label for="migration_status" string="Status:" invisible="not migration_status"/>
                        <field name="migration_status" readonly="1" nolabel="1" 
                               invisible="not migration_status" 
                               widget="text" 
                               class="text-info"
                               style="font-weight: bold;"/>
                        <div invisible="not is_migrating" class="alert alert-info mt-2 mb-2">
                            <i class="fa fa-spinner fa-spin"/> 
                            <strong>Migration in progress...</strong> Count is updating automatically. Please wait...
                        </div>
                    </group>
                </group>
                
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_employee_migration_wizard" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">odoo14.employee.migration.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
