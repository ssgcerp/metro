<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard for Excel Upload -->
    <record id="view_project_upload_wizard_form" model="ir.ui.view">
        <field name="name">project.upload.wizard.form</field>
        <field name="model">project.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Project Excel">
                <group>
                    <field name="excel_file" filename="excel_filename" required="1"/>
                </group>
                <div class="alert alert-info" role="alert">
                    <strong>Expected Excel columns:</strong><br/>
                    Project Code, Name, Project Manager, Customer, Sales Man, Is Amc, Status, Company, Is AMC Project
                </div>
                <group invisible="not error_report_file">
                    <div class="alert alert-warning" role="alert">
                        <strong>Import completed with errors.</strong><br/>
                        Please download the error report below to see which projects failed and why.
                    </div>
                    <field name="error_report_file" filename="error_report_filename" readonly="1"/>
                </group>
                <group invisible="1">
                    <field name="projects_data_json"/>
                </group>
                <footer>
                    <button string="Upload" name="action_upload" type="object" class="btn-secondary" invisible="error_report_file"/>
                    <button string="Proceed" name="action_proceed_import" type="object" class="btn-primary" invisible="not projects_data_json or error_report_file"/>
                    <button string="Download Error Report" name="action_download_error_report" type="object" class="btn-primary" invisible="not error_report_file"/>
                    <button string="Close" class="btn-secondary" special="cancel" invisible="not error_report_file"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" invisible="error_report_file"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_upload_wizard" model="ir.actions.act_window">
        <field name="name">Upload Excel</field>
        <field name="res_model">project.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Tree View -->
    <record id="view_project_migration_line_tree" model="ir.ui.view">
        <field name="name">project.migration.line.tree</field>
        <field name="model">project.migration.line</field>
        <field name="arch" type="xml">
            <list string="Project Migration" multi_edit="1" create="0">
                <field name="project_code"/>
                <field name="name"/>
                <field name="customer_name"/>
                <field name="project_manager_name"/>
                <field name="sales_man_name"/>
                <field name="status_name"/>
                <field name="company_name"/>
                <field name="status" widget="badge" 
                       decoration-success="status == 'migrated'"
                       decoration-warning="status == 'pending_migration' or status == 'queued'"
                       decoration-danger="status == 'error'"
                       decoration-info="status == 'migrating'"/>
                <field name="status_message" optional="hide"/>
                <field name="migration_date" optional="hide"/>
                <field name="odoo19_project_id" optional="hide" widget="many2one"/>
                <button name="action_bulk_migrate" string="Migrate Selected" type="object" 
                        class="btn-primary" icon="fa-download"
                        invisible="status != 'pending_migration'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_project_migration_line_form" model="ir.ui.view">
        <field name="name">project.migration.line.form</field>
        <field name="model">project.migration.line</field>
        <field name="arch" type="xml">
            <form string="Project Migration Line">
                <header>
                    <button name="action_bulk_migrate" string="Migrate" type="object" 
                            class="btn-primary" icon="fa-download"
                            invisible="status != 'pending_migration'"/>
                    <field name="status" widget="statusbar" 
                           statusbar_visible="pending_migration,queued,migrating,migrated"/>
                </header>
                <sheet>
                    <group>
                        <group string="Project Information">
                            <field name="project_code"/>
                            <field name="name"/>
                            <field name="customer_name"/>
                            <field name="project_manager_name"/>
                            <field name="sales_man_name"/>
                            <field name="status_name"/>
                            <field name="company_name"/>
                            <field name="is_amc"/>
                            <field name="is_amc_project"/>
                        </group>
                    </group>
                    <group string="Migration Information">
                        <group>
                            <field name="status"/>
                            <field name="migration_date"/>
                            <field name="odoo19_project_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="status_message" nolabel="1"/>
                        <field name="error_message" nolabel="1" invisible="not error_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_project_migration_line_search" model="ir.ui.view">
        <field name="name">project.migration.line.search</field>
        <field name="model">project.migration.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_code"/>
                <field name="name"/>
                <field name="customer_name"/>
                <field name="status"/>
                <filter name="pending" string="Pending Migration" domain="[('status', '=', 'pending_migration')]"/>
                <filter name="queued" string="Queued" domain="[('status', '=', 'queued')]"/>
                <filter name="migrated" string="Migrated" domain="[('status', '=', 'migrated')]"/>
                <filter name="error" string="Error" domain="[('status', '=', 'error')]"/>
                <separator/>
                <filter name="needs_action" string="Needs Action" domain="[('status', 'in', ['pending_migration', 'queued', 'error'])]"/>
            </search>
        </field>
    </record>
    
    <!-- Server Action for Upload Excel -->
    <record id="action_server_upload_project_excel" model="ir.actions.server">
        <field name="name">Upload Excel</field>
        <field name="model_id" ref="model_project_migration_line"/>
        <field name="binding_model_id" ref="model_project_migration_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = env.ref('odoo14_to_19_migration.action_project_upload_wizard').read()[0]
        </field>
    </record>
    
    <!-- Server Action for Bulk Migrate -->
    <record id="action_server_bulk_migrate_project" model="ir.actions.server">
        <field name="name">Migrate Selected</field>
        <field name="model_id" ref="model_project_migration_line"/>
        <field name="binding_model_id" ref="model_project_migration_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_bulk_migrate()
else:
    raise UserError("Please select at least one project to migrate")
        </field>
    </record>

    <!-- Action -->
    <record id="action_project_migration" model="ir.actions.act_window">
        <field name="name">Project Migration</field>
        <field name="res_model">project.migration.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_project_migration_line_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload Excel file to start migration
            </p>
            <p>
                Click <strong>"Upload Excel"</strong> from the <strong>Action menu (⋮)</strong> in the top right to import Projects from Excel file.
                Excel should have columns: Project Code, Name, Project Manager, Customer, Sales Man, Is Amc, Status, Company, Is AMC Project
            </p>
        </field>
    </record>

</odoo>

