<?xml version="1.0" encoding="UTF-8"?>
<templates xml:id="template" inherit_id="web.assets_backend">
    <t t-name="odoo14_to_19_migration.MigrationProgressWidget" owl="1">
        <div class="migration-progress-widget">
            <t t-if="props.record.data.is_migrating">
                <div class="alert alert-info">
                    <i class="fa fa-spinner fa-spin"/> Migration in progress...
                    <span class="badge badge-primary" t-esc="props.record.data.quotations_migrated"/>
                    /
                    <span class="badge badge-secondary" t-esc="props.record.data.quotations_count"/>
                </div>
            </t>
        </div>
    </t>
</templates>
