<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Purchase Project Request Line List View -->
        <record id="view_purchase_project_request_line_tree" model="ir.ui.view">
            <field name="name">purchase.project.request.line.tree</field>
            <field name="model">purchase.project.request.line</field>
            <field name="priority" eval="16"/>
            <field name="arch" type="xml">
                <list string="Project Requests" editable="bottom">
                    <field name="order_date"/>
                    <field name="requested_project_id"/>
                    <field name="requested_product"/>
                    <field name="requested_qty"/>
                    <field name="requested_user"/>
                </list>
            </field>
        </record>
        
        <!-- Purchase Delivery Order Line List View -->
        <record id="view_purchase_delivery_order_line_tree" model="ir.ui.view">
            <field name="name">purchase.delivery.order.line.tree</field>
            <field name="model">purchase.delivery.order.line</field>
            <field name="priority" eval="16"/>
            <field name="arch" type="xml">
                <list string="Delivery Orders" editable="bottom">
                    <field name="order_date"/>
                    <field name="delivery_number"/>
                </list>
            </field>
        </record>
    </data>
</odoo>

