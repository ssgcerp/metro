<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Purchase Order Form View Extension -->
        <record id="view_purchase_order_form_custom" model="ir.ui.view">
            <field name="name">purchase.order.form.custom</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <!-- Add custom fields after partner_ref -->
                <xpath expr="//field[@name='partner_ref']" position="after">
                    <field name="attention"/>
                    <field name="delivery_address"/>
                    <field name="attention_mobile_number"/>
                    <field name="is_with_stamp"/>
                    <field name="is_wo_header"/>
                    <field name="is_lumpsum"/>
                </xpath>
                
                <!-- Add receipt_date and deliver_to after date_planned -->
                <xpath expr="//field[@name='date_planned']" position="after">
                    <field name="receipt_date"/>
                    <field name="deliver_to"/>
                    <field name="ask_confirmation"/>
                </xpath>
                
                <!-- Add attention_note after reminder or in a suitable location -->
                <xpath expr="//div[@name='reminder']" position="after">
                    <field name="attention_note" placeholder="Enter attention note here..."/>
                </xpath>
                
                <!-- Add RFQ Stage statusbar widget in header -->
                <xpath expr="//header//field[@name='state']" position="after">
                    <field name="rfq_stage_id" widget="statusbar" readonly="1"/>
                </xpath>
                
                <!-- Hide fields that will be moved to Other Information tab -->
                <xpath expr="//field[@name='fiscal_position_id']" position="after">
                    <field name="internal_notes" invisible="1"/>
                    <!-- Hide custom fields that will be in Other Information tab -->
                    <field name="verified_by" invisible="1"/>
                    <field name="approved_by" invisible="1"/>
                    <field name="project_code" invisible="1" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="project" invisible="1"/>
                    <field name="order_contact" invisible="1"/>
                    <field name="contact_no" invisible="1"/>
                    <field name="supplier_quote_ref" invisible="1"/>
                    <field name="sale_order_reference" invisible="1"/>
                    <field name="billing_status" invisible="1"/>
                </xpath>
                
                <!-- Make Received Quantity and Billed Quantity always visible in order_line list -->
                <xpath expr="//field[@name='order_line']//field[@name='qty_received']" position="attributes">
                    <attribute name="column_invisible">0</attribute>
                    <attribute name="string">Received Quantity</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']//field[@name='qty_invoiced']" position="attributes">
                    <attribute name="column_invisible">0</attribute>
                    <attribute name="string">Billed Quantity</attribute>
                </xpath>
                
                <!-- Add tabs: Products, Projects, DO Details, Other Information -->
                <!-- Try to find existing notebook first, if not found, create after order_line -->
                <xpath expr="//field[@name='order_line']" position="after">
                    <notebook>
                        <!-- Projects Tab -->
                        <page string="Projects" name="projects_tab">
                            <field name="project_request_line_ids" nolabel="1"/>
                        </page>
                        
                        <!-- DO Details Tab -->
                        <page string="DO Details" name="do_details_tab">
                            <field name="delivery_order_line_ids" nolabel="1"/>
                        </page>
                        
                        <!-- Other Information Tab -->
                        <page string="Other Information" name="other_info_tab">
                            <group>
                                <group>
                                    <field name="user_id" string="Purchase Representative"/>
                                    <field name="sale_order_reference" readonly="1"/>
                                    <field name="incoterm_id" string="Incoterm"/>
                                    <!-- branch_id field removed as it doesn't exist in standard purchase.order model -->
                                    <field name="verified_by" readonly="1"/>
                                    <field name="approved_by" readonly="1"/>
                                    <field name="project_code" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="project" readonly="1"/>
                                    <field name="order_contact"/>
                                    <field name="contact_no"/>
                                    <field name="supplier_quote_ref"/>
                                </group>
                                <group>
                                    <field name="billing_status" readonly="1"/>
                                    <field name="payment_term_id" string="Payment Terms"/>
                                    <field name="fiscal_position_id" string="Fiscal Position"/>
                                    <field name="internal_notes" placeholder="Enter remarks here..." nolabel="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>
        
        <!-- Purchase Order Tree View Extension -->
        <record id="view_purchase_order_tree_custom" model="ir.ui.view">
            <field name="name">purchase.order.tree.custom</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_tree"/>
            <field name="arch" type="xml">
                <!-- Add project_code to tree view if needed -->
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="project_code" optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

