<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- EQ FC RFQ Stage Form View -->
        <record id="view_eq_fc_rfq_stage_form" model="ir.ui.view">
            <field name="name">eq.fc.rfq.stage.form</field>
            <field name="model">eq.fc.rfq.stage</field>
            <field name="arch" type="xml">
                <form string="RFQ Stage">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="sequence"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="fold"/>
                                <field name="is_default" readonly="1"/>
                                <field name="is_approved_stage"/>
                                <field name="is_locked_stage"/>
                                <field name="color" widget="color_picker"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" placeholder="Description of this stage..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- EQ FC RFQ Stage List View -->
        <record id="view_eq_fc_rfq_stage_tree" model="ir.ui.view">
            <field name="name">eq.fc.rfq.stage.list</field>
            <field name="model">eq.fc.rfq.stage</field>
            <field name="arch" type="xml">
                <list string="RFQ Stages" default_order="sequence">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="is_default"/>
                    <field name="is_approved_stage"/>
                    <field name="is_locked_stage"/>
                    <field name="fold"/>
                    <field name="active" widget="boolean_toggle"/>
                    <field name="color" widget="color_picker"/>
                </list>
            </field>
        </record>

        <!-- EQ FC RFQ Stage Action -->
        <record id="action_eq_fc_rfq_stage" model="ir.actions.act_window">
            <field name="name">RFQ Stages</field>
            <field name="res_model">eq.fc.rfq.stage</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'default_active': True}</field>
        </record>
        
        <!-- Cleanup Duplicates Server Action -->
        <record id="action_cleanup_duplicate_stages" model="ir.actions.server">
            <field name="name">Cleanup Duplicate Stages</field>
            <field name="model_id" ref="model_eq_fc_rfq_stage"/>
            <field name="binding_model_id" ref="model_eq_fc_rfq_stage"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
# Cleanup duplicate stages - duplicates will be removed and page will refresh
model.cleanup_duplicates()
            </field>
        </record>
    </data>
</odoo>

