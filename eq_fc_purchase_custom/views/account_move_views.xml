<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vendor Bill Form View Extension -->
        <record id="view_account_move_form_vendor_bill_custom" model="ir.ui.view">
            <field name="name">account.move.form.vendor.bill.custom</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Add PO Number and Voucher Number after Payment Reference in left column -->
                <xpath expr="//field[@name='payment_reference']" position="after">
                    <field name="voucher_number" optional="show"/>
                    <field name="po_number" string="PO Number" optional="show"/>
                    <field name="is_wo_header" string="Invoice Without Header" widget="boolean_toggle"/>
                    <field name="is_with_stamp" string="With Stamp" widget="boolean_toggle"/>
                </xpath>
                
                <!-- Add Quote Reference and LPO number in Other Info tab (Additional Information section) -->
                <xpath expr="//page[@name='other_info']//group" position="inside">
                    <field name="quote_reference" string="Quote Reference"/>
                    <field name="lpo_number" string="LPO Number"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

