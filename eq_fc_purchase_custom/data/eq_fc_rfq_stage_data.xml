<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default EQ FC RFQ Stages -->
        <record id="eq_fc_rfq_stage_draft" model="eq.fc.rfq.stage">
            <field name="name">Draft</field>
            <field name="sequence">10</field>
            <field name="is_default">True</field>
            <field name="is_approved_stage">False</field>
            <field name="is_locked_stage">False</field>
            <field name="active">True</field>
            <field name="fold">False</field>
            <field name="color">1</field>
            <field name="description">RFQ is in draft state and can be modified.</field>
        </record>

        <record id="eq_fc_rfq_stage_sent" model="eq.fc.rfq.stage">
            <field name="name">RFQ Sent</field>
            <field name="sequence">20</field>
            <field name="is_default">True</field>
            <field name="is_approved_stage">False</field>
            <field name="is_locked_stage">False</field>
            <field name="active">True</field>
            <field name="fold">False</field>
            <field name="color">3</field>
            <field name="description">RFQ has been sent to vendors. Waiting for quotations.</field>
        </record>

        <record id="eq_fc_rfq_stage_approved" model="eq.fc.rfq.stage">
            <field name="name">Approved</field>
            <field name="sequence">30</field>
            <field name="is_default">True</field>
            <field name="is_approved_stage">True</field>
            <field name="is_locked_stage">False</field>
            <field name="active">True</field>
            <field name="fold">False</field>
            <field name="color">10</field>
            <field name="description">RFQ is approved. RFQ number is generated at this stage.</field>
        </record>

        <record id="eq_fc_rfq_stage_locked" model="eq.fc.rfq.stage">
            <field name="name">Locked</field>
            <field name="sequence">40</field>
            <field name="is_default">True</field>
            <field name="is_approved_stage">False</field>
            <field name="is_locked_stage">True</field>
            <field name="active">True</field>
            <field name="fold">True</field>
            <field name="color">2</field>
            <field name="description">RFQ is locked and cannot be modified.</field>
        </record>
    </data>
</odoo>

