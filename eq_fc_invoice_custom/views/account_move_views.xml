<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Customer Invoice Form View Extension -->
        <record id="view_account_move_form_customer_invoice_custom" model="ir.ui.view">
            <field name="name">account.move.form.customer.invoice.custom</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Add Site Name after Invoice Date in right column -->
                <xpath expr="//field[@name='invoice_date']" position="after">
                    <field name="site_name" optional="show"/>
                </xpath>
                
                <!-- Add Location and AMC Contract in left column after Payment Reference -->
                <xpath expr="//field[@name='payment_reference']" position="after">
                    <field name="location" optional="show"/>
                    <field name="amc_contract_id" optional="show"/>
                    <field name="project_id" optional="show"/>
                    <field name="create_do" string="Create DO" widget="boolean_toggle"/>
                </xpath>
                
                <!-- Add Bank Details, File Upload, and Invoice Note in Other Info tab -->
                <xpath expr="//page[@name='other_info']//group" position="inside">
                    <field name="bank_details" string="Bank Details"/>
                    <field name="file_to_upload" filename="filename" string="File"/>
                    <field name="filename" invisible="1"/>
                    <field name="in_note" string="Invoice Note" placeholder="Enter invoice notes here..."/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

