<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-inherit="account_reports.AccountReportFiltersCustomizable" t-inherit-mode="extension">
        <xpath expr="//div[@id='filter_extra_options']" position="after">
            <t t-if="controller.cachedFilterOptions.specific_company_filter">
                <div id="filter_specific_company" class="o_account_reports_filter_specific_company dropdown">
                    <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <i class="fa fa-building"/> <t t-esc="selectedSpecificCompanyName"/>
                    </button>
                    <div class="dropdown-menu">
                        <t t-foreach="controller.cachedFilterOptions.specific_company_filter" t-as="comp" t-key="comp.id">
                            <a role="button" class="dropdown-item" t-on-click="() => this.selectSpecificCompany(comp.id)">
                                <t t-esc="comp.name"/>
                                <span t-if="comp.selected" class="check">✓</span>
                            </a>
                        </t>
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>
