<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default AMC Contract Stages -->
        <record id="amc_contract_stage_draft" model="amc.contract.stage">
            <field name="name">Draft</field>
            <field name="sequence">10</field>
            <field name="is_default">True</field>
            <field name="is_confirmed_stage">False</field>
            <field name="active">True</field>
            <field name="fold">False</field>
            <field name="color">1</field>
            <field name="description">Contract is in draft state and can be modified.</field>
        </record>

        <record id="amc_contract_stage_confirmed" model="amc.contract.stage">
            <field name="name">Confirmed</field>
            <field name="sequence">20</field>
            <field name="is_default">True</field>
            <field name="is_confirmed_stage">True</field>
            <field name="active">True</field>
            <field name="fold">False</field>
            <field name="color">10</field>
            <field name="description">Contract is confirmed and active. Contract number is generated at this stage.</field>
        </record>

        <record id="amc_contract_stage_cancelled" model="amc.contract.stage">
            <field name="name">Cancelled</field>
            <field name="sequence">30</field>
            <field name="is_default">True</field>
            <field name="is_confirmed_stage">False</field>
            <field name="is_cancelled_stage">True</field>
            <field name="active">True</field>
            <field name="fold">True</field>
            <field name="color">2</field>
            <field name="description">Contract has been cancelled.</field>
        </record>

        <record id="amc_contract_stage_blocked" model="amc.contract.stage">
            <field name="name">Blocked</field>
            <field name="sequence">40</field>
            <field name="is_default">True</field>
            <field name="is_confirmed_stage">False</field>
            <field name="active">True</field>
            <field name="fold">True</field>
            <field name="color">2</field>
            <field name="description">Contract is blocked and cannot be processed further.</field>
        </record>

        <record id="amc_contract_stage_expired" model="amc.contract.stage">
            <field name="name">Expired</field>
            <field name="sequence">50</field>
            <field name="is_default">True</field>
            <field name="is_confirmed_stage">False</field>
            <field name="active">True</field>
            <field name="fold">True</field>
            <field name="color">3</field>
            <field name="description">Contract has expired based on end date.</field>
        </record>
    </data>
</odoo>

