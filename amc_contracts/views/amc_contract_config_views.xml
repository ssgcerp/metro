<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- AMC Contract Config Form View -->
        <record id="view_amc_contract_config_form" model="ir.ui.view">
            <field name="name">amc.contract.config.form</field>
            <field name="model">amc.contract.config</field>
            <field name="arch" type="xml">
                <form string="AMC Contract Configuration">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Contract Number Format" name="contract_number_format">
                                <div class="oe_title">
                                    <h1>Contract Number Format Configuration</h1>
                                    <p>Configure how AMC contract numbers are generated.</p>
                                </div>
                                
                                <group>
                                    <group>
                                        <field name="prefix" placeholder="e.g., MFS"/>
                                        <field name="module_code" placeholder="e.g., AMC"/>
                                        <field name="separator" placeholder="e.g., /"/>
                                        <field name="padding_digits" placeholder="e.g., 4"/>
                                        <field name="next_number" placeholder="Leave empty for auto"/>
                                    </group>
                                    <group>
                                        <field name="use_branch_code"/>
                                        <field name="use_year"/>
                                    </group>
                                </group>
                                
                                <group>
                                    <group>
                                        <field name="format_text" 
                                               placeholder="e.g., {prefix}/{modulecode}/{branchcode}/{nextnumber}/{year}"/>
                                    </group>
                                </group>
                                <div class="alert alert-info" role="alert" style="margin-top: 10px;">
                                    <strong>Available Placeholders (case-insensitive):</strong><br/>
                                    <ul style="margin-top: 5px;">
                                        <li><code>{prefix}</code> - Prefix value (e.g., MFS)</li>
                                        <li><code>{modulecode}</code> - Module code (e.g., AMC)</li>
                                        <li><code>{branchcode}</code> - Branch code (e.g., FUJ)</li>
                                        <li><code>{nextnumber}</code> - Sequential number (padded based on Padding Digits, e.g., 0001, 1213)</li>
                                        <li><code>{year}</code> - Year (e.g., 2025)</li>
                                    </ul>
                                    <br/>
                                    <strong>Example Format:</strong><br/>
                                    <code>{prefix}/{modulecode}/{branchcode}/{nextnumber}/{year}</code><br/>
                                    Result: <strong>MFS/AMC/FUJ/1213/2025</strong><br/>
                                    <br/>
                                    <strong>Note:</strong> If Format Text is empty, the standard format will be used based on checkboxes above.
                                </div>
                                
                                <div class="alert alert-info" role="alert">
                                    <strong>Format Example:</strong><br/>
                                    If Prefix = "MFS", Module Code = "AMC", Branch Code = "FUJ", 
                                    Sequential = "1213", Year = "2025", Separator = "/"<br/>
                                    Result: <strong>MFS/AMC/FUJ/1213/2025</strong><br/>
                                    <br/>
                                    <strong>Using Custom Format:</strong><br/>
                                    Format Text: <code>{prefix}/{modulecode}/{branchcode}/{nextnumber}/{year}</code><br/>
                                    Result: <strong>MFS/AMC/FUJ/1213/2025</strong>
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- AMC Contract Config Tree View -->
        <record id="view_amc_contract_config_tree" model="ir.ui.view">
            <field name="name">amc.contract.config.tree</field>
            <field name="model">amc.contract.config</field>
            <field name="arch" type="xml">
                <list string="AMC Contract Configurations">
                    <field name="name"/>
                    <field name="prefix"/>
                    <field name="module_code"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- AMC Contract Config Action -->
        <record id="action_amc_contract_config" model="ir.actions.act_window">
            <field name="name">AMC Settings</field>
            <field name="res_model">amc.contract.config</field>
            <field name="view_mode">list,form</field>
            <field name="limit">1</field>
            <field name="context">{'search_default_active': 1}</field>
        </record>
    </data>
</odoo>

