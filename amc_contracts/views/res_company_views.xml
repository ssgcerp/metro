<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Add Branch Code field to Company form view -->
        <!-- NOTE: This view will be loaded after branch_code column is created in database -->
        <!-- Run: ALTER TABLE res_company ADD COLUMN branch_code VARCHAR(10); -->
        <record id="view_company_form_branch_code" model="ir.ui.view">
            <field name="name">res.company.form.branch.code</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <!-- Add branch code field in the General Information section -->
                <xpath expr="//field[@name='phone']" position="after">
                    <field name="branch_code" placeholder="e.g., AUH, DXB, SHJ, FUJ" 
                           help="Branch code used in AMC contract number generation (e.g., AUH for Abu Dhabi, DXB for Dubai)"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

