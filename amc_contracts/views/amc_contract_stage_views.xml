<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- AMC Contract Stage Form View -->
        <record id="view_amc_contract_stage_form" model="ir.ui.view">
            <field name="name">amc.contract.stage.form</field>
            <field name="model">amc.contract.stage</field>
            <field name="arch" type="xml">
                <form string="AMC Contract Stage">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="sequence" required="1"/>
                                <field name="is_default" readonly="1"/>
                            </group>
                            <group>
                                <field name="active"/>
                                <field name="fold"/>
                                <field name="is_confirmed_stage"/>
                                <field name="is_cancelled_stage"/>
                                <field name="color" widget="color_picker"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" placeholder="Stage description..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- AMC Contract Stage Tree View -->
        <record id="view_amc_contract_stage_tree" model="ir.ui.view">
            <field name="name">amc.contract.stage.tree</field>
            <field name="model">amc.contract.stage</field>
            <field name="arch" type="xml">
                <list string="AMC Contract Stages" default_order="sequence">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="is_default" widget="boolean_toggle"/>
                    <field name="is_confirmed_stage" widget="boolean_toggle"/>
                    <field name="is_cancelled_stage" widget="boolean_toggle"/>
                    <field name="active" widget="boolean_toggle"/>
                    <field name="fold" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- AMC Contract Stage Action -->
        <record id="action_amc_contract_stage" model="ir.actions.act_window">
            <field name="name">Contract Stages</field>
            <field name="res_model">amc.contract.stage</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No stages configured yet!
                </p>
                <p>
                    Configure contract stages to manage the lifecycle of AMC contracts.
                    Default stages (Draft, Confirmed, Cancelled, Blocked, Expired) cannot be deleted but can be reordered.
                </p>
            </field>
        </record>
    </data>
</odoo>
