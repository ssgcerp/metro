<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Asset List View -->
    <record id="view_amc_contract_asset_list" model="ir.ui.view">
        <field name="name">amc.contract.asset.list</field>
        <field name="model">amc.contract.asset</field>
        <field name="arch" type="xml">
            <list string="Assets">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="location"/>
                <field name="serial_number"/>
                <field name="contract_id"/>
            </list>
        </field>
    </record>

    <!-- Asset Form View -->
    <record id="view_amc_contract_asset_form" model="ir.ui.view">
        <field name="name">amc.contract.asset.form</field>
        <field name="model">amc.contract.asset</field>
        <field name="arch" type="xml">
            <form string="Asset">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="code" readonly="1"/>
                        </h1>
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Asset Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="category"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="serial_number"/>
                            <field name="model_number"/>
                            <field name="brand"/>
                        </group>
                        <group string="Warranty Info">
                            <field name="date_installation"/>
                            <field name="warranty_expiry"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
</odoo>
