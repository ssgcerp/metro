<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Audit Schedule List View -->
    <record id="view_amc_contract_audit_schedule_list" model="ir.ui.view">
        <field name="name">amc.contract.audit.schedule.list</field>
        <field name="model">amc.contract.audit.schedule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="audit_date"/>
                <field name="auditor_id" widget="many2one_avatar_user"/>
                <field name="status"/>
                <field name="remarks"/>
            </list>
        </field>
    </record>

    <!-- Audit Schedule Form View -->
    <record id="view_amc_contract_audit_schedule_form" model="ir.ui.view">
        <field name="name">amc.contract.audit.schedule.form</field>
        <field name="model">amc.contract.audit.schedule</field>
        <field name="arch" type="xml">
            <form string="Audit Schedule">
                <sheet>
                    <group>
                        <group>
                            <field name="contract_id" readonly="1"/>
                            <field name="audit_date"/>
                        </group>
                        <group>
                            <field name="auditor_id"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Findings">
                            <field name="findings"/>
                        </page>
                        <page string="Remarks">
                            <field name="remarks"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
</odoo>
