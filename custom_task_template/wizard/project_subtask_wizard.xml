<odoo>
    <record id="view_project_task_wizard_form" model="ir.ui.view">
        <field name="name">project.task.wizard.form</field>
        <field name="model">project.task.wizard</field>
        <field name="arch" type="xml">
            <form string="Task Details" create="false" edit="false">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                    <footer>
                        <button name="action_save" string="Save" type="object" class="btn-primary"/>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
