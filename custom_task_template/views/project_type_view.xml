<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_type_tree" model="ir.ui.view">
        <field name="name">project.type.tree</field>
        <field name="model">project.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="use_gmb" optional="show"/>
                <field name="use_social" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form view for Project Types -->
    <record id="view_project_type_form" model="ir.ui.view">
        <field name="name">project.type.form</field>
        <field name="model">project.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="use_gmb" widget="boolean_toggle"/>
                            <field name="use_social" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_project_type" model="ir.actions.act_window">
        <field name="name">Project Types</field>
        <field name="res_model">project.type</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="project_type_menu" 
              name="Project Types" 
              parent="project.menu_project_config" 
              action="action_project_type"/>
</odoo>
