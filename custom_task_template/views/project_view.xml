<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_project_form_inherit_timer" model="ir.ui.view">
    <field name="name">project.project.form.inherit.timer</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.edit_project"/>
    <field name="arch" type="xml">
        <xpath expr="//header" position="inside">
            <button name="action_apply_task_timer"
                    type="object"
                    string="Apply Task Timer"
                    class="btn-secondary"
                    invisible="id == False"/>
        </xpath>
    </field>
</record>
</odoo>
