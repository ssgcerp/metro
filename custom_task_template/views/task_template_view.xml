<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_task_template_tree" model="ir.ui.view">
        <field name="name">task.template.tree</field>
        <field name="model">task.template</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_apply_task_template_wizard" type="object" string="Apply Task Template" class="oe_highlight"/>
                </header>
                <field name="subject"/>

                <field name="template_sub_group_id"/>
                <field name="priority"/>
                <field name="number_of_days_to_start"/>
                <field name="due_days"/>
            </list>
        </field>
    </record>
    <record id="view_task_template_form" model="ir.ui.view">
        <field name="name">task.template.form</field>
        <field name="model">task.template</field>
        <field name="arch" type="xml">
            <form string="Task Template">
                <sheet>
                    <group>
                            <group>
                                <field name="subject"/>
                                <field name="template_group_id"/>
                                <field name="enable_platform" invisible="1"/>
                                <field name="platform" invisible="enable_platform == False"/>
                                <field name="template_sub_group_id"/>
                                <field name="number_of_days_to_start"/>
                                <field name="due_days"/>
                                <field name="priority"/>
                                <field name="tag_ids" widget="many2many_tags"/>
                            </group>
                            <group>
                                <label for="repeat_interval"/>
                                <div class="d-flex">
                                    <field name="repeat_interval" class="me-2" style="max-width: 2rem !important;"/>
                                    <field name="repeat_unit" required="repeat_interval" class="me-2" style="max-width: 4rem !important;"/>
                                </div>
                                <field name="total_cycle" invisible="infinite_cycle"/>
                                <field name="infinite_cycle"/>
                                <field name="multiple_entries"/>
                                <field name="description"/>
                            </group>
                    </group>

                    <group>
                        <field name="checklist_ids">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="role_id"/>
                            </list>
                        </field>
                    </group>

                    <group>
                        <field name="assignee_ids" widget="many2many_tags"/>
                        <field name="follower_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_task_template" model="ir.actions.act_window">
        <field name="name">Task Templates</field>
        <field name="res_model">task.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Create and manage task templates.</p>
        </field>
    </record>
    <menuitem id="menu_task_template"
              name="Task Templates"
              parent="project.menu_main_pm"
              action="action_task_template"
              sequence="50"/>
</odoo>
