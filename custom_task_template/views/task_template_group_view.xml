<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_task_template_group_tree" model="ir.ui.view">
        <field name="name">task.template.group.tree</field>
        <field name="model">task.template.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="enable_platform"/>
            </list>
        </field>
    </record>
    <record id="view_task_template_group_form" model="ir.ui.view">
        <field name="name">task.template.group.form</field>
        <field name="model">task.template.group</field>
        <field name="arch" type="xml">
            <form string="Task Template Group">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="enable_platform"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_task_template_group" model="ir.actions.act_window">
        <field name="name">Template Group</field>
        <field name="res_model">task.template.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Create and manage task template group here.</p>
        </field>
    </record>

    <menuitem id="menu_task_template_group"
              name="Template Group"
              parent="menu_task_settings"
              action="action_task_template_group"
              sequence="20"/>
</odoo>
