<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_post_form" model="ir.ui.view">
        <field name="name">google.post.form</field>
        <field name="model">google.post</field>
        <field name="arch" type="xml">
            <form string="Google Business Post">
                <header>
                    <button name="action_publish_post" string="Publish Now" type="object" class="btn-primary" invisible="state == 'posted'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="summary" string="Title / Summary"/>
                        <h1><field name="summary"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="profile_id"/>
                            <field name="post_type"/>
                        </group>
                        <group>
                            <field name="action_type"/>
                            <field name="action_url" invisible="not action_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content">
                            <field name="content"/>
                        </page>
                        <page string="Event/Offer Details" invisible="post_type not in ('EVENT', 'OFFER')">
                            <group>
                                <group>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </group>
                                <group invisible="post_type != 'OFFER'">
                                    <field name="coupon_code"/>
                                    <field name="redemption_url"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_google_post_tree" model="ir.ui.view">
        <field name="name">google.post.list</field>
        <field name="model">google.post</field>
        <field name="arch" type="xml">
            <list string="Posts">
                <field name="summary"/>
                <field name="profile_id"/>
                <field name="post_type"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>
    
    <record id="action_google_post" model="ir.actions.act_window">
        <field name="name">Posts</field>
        <field name="res_model">google.post</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
