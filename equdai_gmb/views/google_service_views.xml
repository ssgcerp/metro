<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_service_tree" model="ir.ui.view">
        <field name="name">google.service.list</field>
        <field name="model">google.service</field>
        <field name="arch" type="xml">
            <list string="Services" editable="bottom">
                <field name="profile_id"/>
                <field name="name"/>
                <field name="price" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="action_google_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">google.service</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
