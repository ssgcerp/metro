<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form_gmb_inherit" model="ir.ui.view">
        <field name="name">project.task.form.gmb.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                 <button name="action_view_google_posts" type="object" class="oe_stat_button" icon="fa-share-alt" invisible="google_post_count == 0">
                    <field name="google_post_count" widget="statinfo" string="G Posts"/>
                 </button>
                 <button name="action_view_google_reviews" type="object" class="oe_stat_button" icon="fa-star" invisible="google_review_count == 0">
                    <field name="google_review_count" widget="statinfo" string="G Reviews"/>
                 </button>
            </div>
            <page name="extra_info" position="before">
                <page string="Google Business" name="google_business">
                    <group>
                        <field name="google_post_ids" widget="many2many">
                            <list>
                                <field name="summary"/>
                                <field name="state"/>
                            </list>
                        </field>
                        <field name="google_review_ids" widget="many2many">
                            <list>
                                <field name="reviewer_name"/>
                                <field name="rating" widget="priority"/>
                            </list>
                        </field>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
