<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_statement_wizard_form" model="ir.ui.view">
        <field name="name">partner.statement.wizard.form</field>
        <field name="model">partner.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Partner Statement">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="target_move" widget="radio"/>
                        <field name="account_type" widget="radio"/>
                    </group>
                </group>
                <group>
                    <field name="partner_ids" widget="many2many_tags"/>
                </group>
                <group string="Options">
                    <group>
                        <field name="show_aging"/>
                        <field name="show_running_balance"/>
                    </group>
                    <group>
                        <field name="include_reconciled"/>
                    </group>
                </group>
                <footer>
                    <button string="Print PDF" name="action_print_pdf" type="object" class="btn-primary"/>
                    <button string="Export XLSX" name="action_print_xlsx" type="object" class="btn-secondary"/>
                    <button string="Send by Email" name="action_send_email" type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_partner_statement_wizard" model="ir.actions.act_window">
        <field name="name">Partner Statement</field>
        <field name="res_model">partner.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item (Temporary until menu structure file is created) -->
    <!-- We will rely on menu_items.xml for the actual menu -->
</odoo>
