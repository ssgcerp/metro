<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-inherit="web.Dialog" t-inherit-mode="extension">
        <xpath expr="//t[@t-slot='header']" position="before">
            <span t-if="!isFullscreen" class="me-2 z-buttons">
                <button class="btn btn-sm rounded-0 fs-3 lh-1 align-text-top" tabindex="-1" t-on-click="toggle_dialog_size">
                    <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-picture-in-picture">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M11 19h-6a2 2 0 0 1 -2 -2v-10a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v4" />
                        <path d="M14 14m0 1a1 1 0 0 1 1 -1h5a1 1 0 0 1 1 1v3a1 1 0 0 1 -1 1h-5a1 1 0 0 1 -1 -1z" />
                    </svg>
                </button>
                <button class="btn btn-sm rounded-0 fs-3 lh-1 align-text-top" data-tooltip="Expand" data-hotkey="m" tabindex="-1" t-on-click="switch_dialog_size">
                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-autofit-width">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M4 12v-6a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v6" />
                        <path d="M10 18h-7" />
                        <path d="M21 18h-7" />
                        <path d="M6 15l-3 3l3 3" />
                        <path d="M18 15l3 3l-3 3" />
                    </svg>
                </button>
            </span>
        </xpath>
    </t>
</templates>