<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">
            res.config.settings.view.form.inherit.ir_attachment_s3
        </field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="11" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="S3 Attachment Storage" name="s3_attachment_storage" groups="base.group_system">
                    <setting string="S3 Configuration" id="s3_configuration">
                        <div class="content-group">
                            <div class="mt16">
                                <label for="s3_bucket" string="S3 bucket name" class="col-3 col-lg-3 o_light_label"/>
                                <field name="s3_bucket" class="oe_inline"/>
                            </div>
                            <div class="mt16">
                                <label for="s3_access_key_id" string="S3 access key id" class="col-3 col-lg-3 o_light_label"/>
                                <field name="s3_access_key_id" class="oe_inline"/>
                            </div>
                            <div class="mt16">
                                <label for="s3_secret_key" string="S3 secret key" class="col-3 col-lg-3 o_light_label"/>
                                <field name="s3_secret_key" class="oe_inline" password="True"/>
                            </div>
                            <div class="mt16">
                                <label for="s3_endpoint_url" string="S3 Endpoint" class="col-3 col-lg-3 o_light_label"/>
                                <field name="s3_endpoint_url" class="oe_inline"/>
                            </div>
                            <div class="mt16">
                                <label for="s3_obj_url" string="S3 URL" class="col-3 col-lg-3 o_light_label"/>
                                <field name="s3_obj_url" class="oe_inline"/>
                            </div>
                            <div class="mt16">
                                <label for="s3_condition" string="S3 condition" class="col-3 col-lg-3 o_light_label"/>
                                <field name="s3_condition" class="oe_inline" placeholder="[('res_model', 'in', ['product.image'])]"/>
                            </div>
                            <div class="mt16">
                                <button
                                    name="s3_upload_existing"
                                    type="object"
                                    string="Upload existing attachments"
                                    invisible="1"
                                />
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
    <record id="ir_attachment_s3_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form" />
        <field name="view_mode">form</field>
        <field name="context">{'module' : 'ir_attachment_s3'}</field>
    </record>
    <menuitem
        id="menu_s3_settings"
        name="S3 Settings"
        parent="base.next_id_9"
        sequence="0"
        action="ir_attachment_s3_config_settings_action"
        groups="base.group_system"
    />
</odoo>
