<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="view_invoice_discount_form">
        <field name="name">invoice.discount.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']" position="after">
                <group string="Discount Configuration">
                    <field name="type" readonly="state != 'draft'"/>
                    <field name="discount_type" invisible="type == 'retention' or not type" readonly="state != 'draft'"/>
                    <field name="is_tax_after_discount" invisible="type == 'retention' or not type" readonly="state != 'draft'"/>
                    <field name="discount_rate" required="discount_type != False" invisible="type == 'retention' or not type" readonly="state != 'draft'"/>
                    <field name="discount_narration" invisible="type == 'retention' or not type" readonly="state != 'draft'"/>
                    <field name="retention_rate" required="type == 'retention'" invisible="type == 'discount' or not type" readonly="state != 'draft'"/>
                    <button string="Apply Retention" type="object" name="apply_retention_"
                            invisible="type == 'discount' or not type"
                            class="oe_highlight"/>
                    <field name="analytic_id" groups="analytic.group_analytic_accounting" readonly="state != 'draft'"/>
                    <button string="Apply Discount" type="object" name="apply_discount"
                            invisible="type == 'retention' or not type"
                            class="oe_highlight"/>
                </group>
            </xpath>
            <!-- Totals block (Odoo 19) -->
            <xpath expr="//group[@class='oe_subtotal_footer']" position="inside">
                <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                    <label for="amount_discount"/>
                </div>
                <field name="amount_discount"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>

                <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                    <label for="amount_total_with_discount"/>
                </div>
                <field name="amount_total_with_discount"
                       nolabel="1"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
            </xpath>
            <!--            <xpath expr="//field[@name='amount_total']" position="replace">-->
            <!--            	<field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>-->
            <!--            </xpath>-->
        </field>
    </record>
</odoo>

