<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Discounts" name="global_discounts">
                    <setting string="Default Discount Accounts" id="discount_accounts">
                        <div class="content-group">
                            <div class="mt16">
                                <label for="def_discount_sales_account_id" string="Sales Discount Account" class="col-3 col-lg-3 o_light_label"/>
                                <field name="def_discount_sales_account_id" class="oe_inline"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                            </div>
                            <div class="mt16">
                                <label for="def_discount_purchase_account_id" string="Purchase Discount Account" class="col-3 col-lg-3 o_light_label"/>
                                <field name="def_discount_purchase_account_id" class="oe_inline"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Retention Product" id="retention_product">
                        <div class="content-group">
                            <div class="mt16">
                                <label for="retention_product_id" string="Retention Product" class="col-3 col-lg-3 o_light_label"/>
                                <field name="retention_product_id" class="oe_inline"
                                       domain="[('is_retention_product', '=', True)]"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

