<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="view_sale_order_discount_form">
        <field name="name">sale.order.discount.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']" position="after">
                <group string="Discount Configuration">
                    <field name="type" readonly="state != 'draft'"/>
                    <field name="discount_type" invisible="type == 'retention' or not type" readonly="state != 'draft'"/>
                    <field name="is_tax_after_discount" invisible="type == 'retention' or not type" readonly="state != 'draft'"/>
                    <field name="discount_rate" required="discount_type != False" invisible="type == 'retention' or not type" readonly="state != 'draft'"/>
                    <field name="discount_narration" invisible="type == 'retention' or not type" readonly="state != 'draft'"/>
                    <field name="retention_rate" required="type == 'retention'" invisible="type == 'discount' or not type" readonly="state != 'draft'"/>
                    <button string="Apply Retention" type="object" name="apply_retention" invisible="type == 'discount' or not type" class="oe_highlight"/>
                    <field name="analytic_id" groups="analytic.group_analytic_accounting" readonly="state != 'draft'"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="before">
                <field name="amount_discount" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                <field name="amount_total_with_discount" widget='monetary' options="{'currency_field': 'currency_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>

