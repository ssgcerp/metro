<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_invoice_document_global_discount" inherit_id="account.report_invoice_document">
            <!-- Insert discount rows before the invoice tax totals -->
            <xpath expr="//t[@t-call='account.document_tax_totals']" position="before">
                <tr>
                    <td><strong>Total</strong></td>
                    <td class="text-end">
                        <span t-field="o.amount_grand"
                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </td>
                </tr>
                <tr>
                    <td><strong>Discount</strong></td>
                    <td class="text-end">
                        <span t-field="o.amount_discount"
                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </td>
                </tr>
                <tr>
                    <td><strong>Total After Discount</strong></td>
                    <td class="text-end">
                        <span t-field="o.amount_total_with_discount"
                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </td>
                </tr>
            </xpath>
        </template>
    </data>
</odoo>
