<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_global_discount" inherit_id="sale.report_saleorder_document">
        <!-- Insert discount rows before tax totals -->
        <xpath expr="//t[@t-call='sale.document_tax_totals']" position="before">
            <tr>
                <td><strong>Total</strong></td>
                <td class="text-end">
                    <span t-field="doc.amount_grand"
                          t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                </td>
            </tr>
            <tr>
                <td><strong>Discount</strong></td>
                <td class="text-end">
                    <span t-field="doc.amount_discount"
                          t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                </td>
            </tr>
            <tr>
                <td><strong>Total After Discount</strong></td>
                <td class="text-end">
                    <span t-field="doc.amount_total_with_discount"
                          t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                </td>
            </tr>
        </xpath>
    </template>
</odoo>
