<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Project Estimation Sales Line Tree View -->
        <record id="view_project_estimation_sales_line_tree" model="ir.ui.view">
            <field name="name">project.estimation.sales.line.tree</field>
            <field name="model">project.estimation.sales.line</field>
            <field name="arch" type="xml">
                <tree string="Estimation Sales Lines" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="product_id" options="{'no_create': True}"/>
                    <field name="product_reference" readonly="1"/>
                    <field name="brand_id" readonly="1"/>
                    <field name="description"/>
                    <field name="quantity"/>
                    <field name="product_uom" readonly="1"/>
                </tree>
            </field>
        </record>

        <!-- Project Estimation Sales Line Form View -->
        <record id="view_project_estimation_sales_line_form" model="ir.ui.view">
            <field name="name">project.estimation.sales.line.form</field>
            <field name="model">project.estimation.sales.line</field>
            <field name="arch" type="xml">
                <form string="Estimation Sales Line">
                    <sheet>
                        <group>
                            <group>
                                <field name="project_id" readonly="1"/>
                                <field name="sequence"/>
                                <field name="product_id" options="{'no_create': True}"/>
                                <field name="product_reference" readonly="1"/>
                            </group>
                            <group>
                                <field name="brand_id" readonly="1"/>
                                <field name="quantity"/>
                                <field name="product_uom" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" placeholder="Description of the estimation line..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Project Consumable Line Tree View -->
        <record id="view_project_consumable_line_tree" model="ir.ui.view">
            <field name="name">project.consumable.line.tree</field>
            <field name="model">project.consumable.line</field>
            <field name="arch" type="xml">
                <tree string="Consumables" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="product_id" options="{'no_create': True}"/>
                    <field name="description"/>
                    <field name="quantity"/>
                    <field name="product_uom" readonly="1"/>
                </tree>
            </field>
        </record>

        <!-- Project Delivery Indent Tree View -->
        <record id="view_project_delivery_indent_tree" model="ir.ui.view">
            <field name="name">project.delivery.indent.tree</field>
            <field name="model">project.delivery.indent</field>
            <field name="arch" type="xml">
                <tree string="Delivery Indents">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="partner_id"/>
                    <field name="state" widget="badge" decoration-info="state == 'confirmed'" decoration-success="state == 'delivered'" decoration-danger="state == 'cancelled'"/>
                </tree>
            </field>
        </record>

        <!-- Project Delivery Indent Form View -->
        <record id="view_project_delivery_indent_form" model="ir.ui.view">
            <field name="name">project.delivery.indent.form</field>
            <field name="model">project.delivery.indent</field>
            <field name="arch" type="xml">
                <form string="Delivery Indent">
                    <sheet>
                        <group>
                            <group>
                                <field name="project_id" readonly="1"/>
                                <field name="name"/>
                                <field name="date"/>
                            </group>
                            <group>
                                <field name="partner_id"/>
                                <field name="state"/>
                            </group>
                        </group>
                        <group>
                            <field name="notes" placeholder="Additional notes..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Project Inventory Return Tree View -->
        <record id="view_project_inventory_return_tree" model="ir.ui.view">
            <field name="name">project.inventory.return.tree</field>
            <field name="model">project.inventory.return</field>
            <field name="arch" type="xml">
                <tree string="Inventory Returns">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="partner_id"/>
                    <field name="state" widget="badge" decoration-info="state == 'confirmed'" decoration-success="state == 'returned'" decoration-danger="state == 'cancelled'"/>
                </tree>
            </field>
        </record>

        <!-- Project Inventory Return Form View -->
        <record id="view_project_inventory_return_form" model="ir.ui.view">
            <field name="name">project.inventory.return.form</field>
            <field name="model">project.inventory.return</field>
            <field name="arch" type="xml">
                <form string="Inventory Return">
                    <sheet>
                        <group>
                            <group>
                                <field name="project_id" readonly="1"/>
                                <field name="name"/>
                                <field name="date"/>
                            </group>
                            <group>
                                <field name="partner_id"/>
                                <field name="state"/>
                            </group>
                        </group>
                        <group>
                            <field name="notes" placeholder="Additional notes..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Project Cheque Detail Tree View -->
        <record id="view_project_cheque_detail_tree" model="ir.ui.view">
            <field name="name">project.cheque.detail.tree</field>
            <field name="model">project.cheque.detail</field>
            <field name="arch" type="xml">
                <tree string="Cheque Details">
                    <field name="cheque_number"/>
                    <field name="cheque_date"/>
                    <field name="bank_name"/>
                    <field name="amount"/>
                    <field name="partner_id"/>
                    <field name="state" widget="badge" decoration-info="state == 'issued'" decoration-success="state == 'cleared'" decoration-danger="state in ['bounced', 'cancelled']"/>
                </tree>
            </field>
        </record>

        <!-- Project Cheque Detail Form View -->
        <record id="view_project_cheque_detail_form" model="ir.ui.view">
            <field name="name">project.cheque.detail.form</field>
            <field name="model">project.cheque.detail</field>
            <field name="arch" type="xml">
                <form string="Cheque Detail">
                    <sheet>
                        <group>
                            <group>
                                <field name="project_id" readonly="1"/>
                                <field name="cheque_number"/>
                                <field name="cheque_date"/>
                            </group>
                            <group>
                                <field name="bank_name"/>
                                <field name="amount"/>
                                <field name="currency_id"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="partner_id"/>
                                <field name="state"/>
                            </group>
                        </group>
                        <group>
                            <field name="notes" placeholder="Additional notes..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Project Form View with Dashboard Tabs -->
        <record id="view_project_form_dashboard" model="ir.ui.view">
            <field name="name">project.project.form.dashboard</field>
            <field name="model">project.project</field>
            <field name="arch" type="xml">
                <form string="Project Dashboard" create="1" edit="1">
                    <header>
                        <field name="stage_id" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(project.action_view_task)d" type="action" 
                                    class="oe_stat_button" icon="fa-tasks" context="{'default_project_id': id}">
                                <field name="task_count" widget="statinfo" string="Tasks"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name" placeholder="Project Name"/>
                                <field name="is_amc_project"/>
                                <field name="name_of_tasks"/>
                            </group>
                            <group>
                                <field name="partner_id" options="{'no_create': False}"/>
                                <field name="user_id" options="{'no_create': False}"/>
                            </group>
                        </group>
                        
                        <!-- Dashboard tabs -->
                        <notebook>
                    <page string="Project Summary" name="project_summary">
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="is_amc_project"/>
                                <field name="name_of_tasks"/>
                            </group>
                            <group>
                                <field name="partner_id"/>
                                <field name="user_id"/>
                                <field name="stage_id"/>
                            </group>
                        </group>
                    </page>
                    
                    <page string="Estimation Sales Lines" name="estimation_sales_lines">
                        <field name="estimation_sales_line_ids" nolabel="1">
                            <tree string="Estimation Sales Lines" editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="product_id" options="{'no_create': True}"/>
                                <field name="product_reference" readonly="1"/>
                                <field name="brand_id" readonly="1"/>
                                <field name="description"/>
                                <field name="quantity"/>
                                <field name="product_uom" readonly="1"/>
                            </tree>
                        </field>
                    </page>
                    
                    <page string="Description" name="description">
                        <field name="dashboard_description" nolabel="1" widget="html"/>
                    </page>
                    
                    <page string="Consumables" name="consumables">
                        <field name="consumable_line_ids" nolabel="1">
                            <tree string="Consumables" editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="product_id" options="{'no_create': True}"/>
                                <field name="description"/>
                                <field name="quantity"/>
                                <field name="product_uom" readonly="1"/>
                            </tree>
                        </field>
                    </page>
                    
                    <page string="Delivery Indents" name="delivery_indents">
                        <field name="delivery_indent_ids" nolabel="1">
                            <tree>
                                <field name="name"/>
                                <field name="date"/>
                                <field name="partner_id"/>
                                <field name="state" widget="badge" decoration-info="state == 'confirmed'" decoration-success="state == 'delivered'" decoration-danger="state == 'cancelled'"/>
                            </tree>
                        </field>
                    </page>
                    
                    <page string="Inventory Return" name="inventory_return">
                        <field name="inventory_return_ids" nolabel="1">
                            <tree>
                                <field name="name"/>
                                <field name="date"/>
                                <field name="partner_id"/>
                                <field name="state" widget="badge" decoration-info="state == 'confirmed'" decoration-success="state == 'returned'" decoration-danger="state == 'cancelled'"/>
                            </tree>
                        </field>
                    </page>
                    
                    <page string="Cheque Details" name="cheque_details">
                        <field name="cheque_detail_ids" nolabel="1">
                            <tree>
                                <field name="cheque_number"/>
                                <field name="cheque_date"/>
                                <field name="bank_name"/>
                                <field name="amount"/>
                                <field name="partner_id"/>
                                <field name="state" widget="badge" decoration-info="state == 'issued'" decoration-success="state == 'cleared'" decoration-danger="state in ['bounced', 'cancelled']"/>
                            </tree>
                        </field>
                    </page>
                    
                    <page string="Settings" name="settings">
                        <group>
                            <group>
                                <field name="active"/>
                                <field name="privacy_visibility"/>
                                <field name="allow_billable"/>
                            </group>
                            <group>
                                <field name="date_start"/>
                                <field name="date"/>
                            </group>
                        </group>
                    </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Project List View -->
        <record id="view_project_tree_dashboard" model="ir.ui.view">
            <field name="name">project.project.tree.dashboard</field>
            <field name="model">project.project</field>
            <field name="arch" type="xml">
                <tree string="Projects">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="user_id"/>
                    <field name="is_amc_project"/>
                    <field name="stage_id"/>
                </tree>
            </field>
        </record>

        <!-- Project Search View -->
        <record id="view_project_search_dashboard" model="ir.ui.view">
            <field name="name">project.project.search.dashboard</field>
            <field name="model">project.project</field>
            <field name="arch" type="xml">
                <search string="Projects">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="user_id"/>
                    <field name="is_amc_project"/>
                    <filter string="AMC Projects" name="amc_projects" domain="[('is_amc_project', '=', True)]"/>
                    <filter string="My Projects" name="my_projects" domain="[('user_id', '=', uid)]"/>
                </search>
            </field>
        </record>
    </data>
</odoo>






