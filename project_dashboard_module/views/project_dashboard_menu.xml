<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Project Dashboard Action -->
        <record id="action_project_dashboard" model="ir.actions.act_window">
            <field name="name">Project Dashboard</field>
            <field name="res_model">project.project</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('project_dashboard_module.view_project_tree_dashboard')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('project_dashboard_module.view_project_form_dashboard')})]"/>
            <field name="search_view_id" ref="project_dashboard_module.view_project_search_dashboard"/>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first project!
                </p><p>
                    Projects help you organize and track all your work. Click on any project to view its detailed dashboard with multiple tabs.
                </p>
            </field>
        </record>

        <!-- Project Dashboard Menu Item -->
        <!-- Try standard project menu first, fallback to root if needed -->
        <menuitem id="menu_project_dashboard"
                  name="Project Dashboard"
                  action="action_project_dashboard"
                  parent="project.menu_main_pm"
                  sequence="10"/>
        
        <!-- Alternative menu if project.menu_main_pm doesn't exist -->
        <!-- Uncomment below and comment above if menu doesn't appear -->
        <!--
        <menuitem id="menu_project_dashboard_root"
                  name="Project Dashboard"
                  action="action_project_dashboard"
                  parent="project.menu_project_management"
                  sequence="10"/>
        -->
    </data>
</odoo>





