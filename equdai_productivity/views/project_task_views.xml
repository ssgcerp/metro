<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2_inherit_productivity" model="ir.ui.view">
        <field name="name">project.task.form.inherit.productivity</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <!-- Header Button -->
            <xpath expr="//header" position="inside">
                <button name="action_toggle_block" 
                        string="Block Task" 
                        type="object" 
                        class="btn-warning" 
                        invisible="is_blocked"/>
                <button name="action_toggle_block" 
                        string="Unblock Task" 
                        type="object" 
                        class="btn-secondary" 
                        invisible="not is_blocked"/>
            </xpath>

            <!-- Ribbon -->
            <xpath expr="//sheet" position="before">
                 <widget name="web_ribbon" title="Blocked" bg_color="text-bg-danger" invisible="not is_blocked"/>
            </xpath>

            <!-- Blocker Details Group -->
            <xpath expr="//group" position="inside">
                <group string="Blocker Details" invisible="not is_blocked">
                    <field name="blocker_type" required="is_blocked"/>
                    <field name="blocker_reason" required="is_blocked"/>
                    <field name="blocked_date"/>
                </group>
            </xpath>
            
            <!-- Kanban View Enhancements -->
        </field>
    </record>

    <!-- Kanban View inheritance to show blocker status -->
    <record id="view_task_kanban_inherit_productivity" model="ir.ui.view">
        <field name="name">project.task.kanban.inherit.productivity</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="is_blocked"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="before">
                <div class="ribbon ribbon-top-right" invisible="not is_blocked">
                    <span class="text-bg-danger">Blocked</span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
