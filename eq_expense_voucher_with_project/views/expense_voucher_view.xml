<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_list_account_expense" model="ir.ui.view">
        <field name="name">account.expense.voucher.list</field>
        <field name="model">account.expense.voucher</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <list string="Expense Voucher" default_order="date desc">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="journal_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="voucher_type"/>
                <field name="total_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_tree_expense_voucher_line" model="ir.ui.view">
        <field name="name">account.expense.voucher.line.tree</field>
        <field name="model">account.expense.voucher.line</field>
        <field name="type">list</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="account_id"/>
                <field name="label"/>
                <field name="project_id"/>
                <field name="price_amount"/>
                <field name="tax_id"/>
                <field name="tax_amount" invisible="1"/>
                <field name="subtotal"/>
            </list>
        </field>
    </record>

    <record id="view_form_account_expense_voucher" model="ir.ui.view">
        <field name="model">account.expense.voucher</field>
        <field name="name">account.expense.voucher.form</field>
        <field name="arch" type="xml">
            <form string="Expense Voucher">
                <header>
                    <field name="is_approver" invisible="1"/>

                    <button string="Send For Approval"
                            class="oe_highlight"
                            name="button_send_for_approval"
                            type="object"
                            invisible="state != 'draft'"/>

                    <button string="Approve"
                            type="object"
                            name="action_submit"
                            class="oe_highlight"
                            invisible="state != 'pending' or not is_approver"/>

                    <button string="Reject"
                            class="oe_highlight"
                            name="button_reject"
                            type="object"
                            invisible="state != 'pending' or not is_approver"/>

                    <button string="Post"
                            type="object"
                            name="action_post"
                            class="oe_highlight"
                            invisible="state != 'submit'"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>

                <sheet string="Expense Voucher">
                    <div class="oe_title">
                        <h1>
                            <group>
                                <field name="name" class="oe_title" nolabel="1"/>
                            </group>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="voucher_type"/>
                            <field name="journal_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="reference"/>
                        </group>
                        <group>
                            <field name="partner_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="date"/>
                            <field name="payment_entry_id" invisible="not payment_entry_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Expense Lines" name="expense_lines">
                            <field name="expense_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="account_id"/>
                                    <field name="label"/>
                                    <field name="project_id"/>
                                    <field name="price_amount"/>
                                    <field name="tax_id"/>
                                    <field name="tax_amount" invisible="1"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>

                            <group name="note_group" col="6" class="mt-2 mt-md-0">
                                <group colspan="4">
                                    <field name="comments" nolabel="1" placeholder="Comments..."/>
                                </group>
                                <group class="oe_subtotal_footer oe_right" colspan="2" name="sale_total">
                                    <field name="untaxed_amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="tax_amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                        <label for="total_amount"/>
                                    </div>
                                    <field name="total_amount" nolabel="1" class="oe_subtotal_footer_separator"
                                           widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </group>
                                <div class="oe_clear"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_account_expense_voucher" model="ir.actions.act_window">
        <field name="name">Account Expense Voucher</field>
        <field name="res_model">account.expense.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_list_account_expense"/>
    </record>

    <record id="action_server_post_expense_voucher" model="ir.actions.server">
        <field name="name">Post</field>
        <field name="model_id" ref="model_account_expense_voucher"/>
        <field name="binding_model_id" ref="model_account_expense_voucher"/>
        <field name="state">code</field>
        <field name="code">action = records.action_post()</field>
    </record>

    <menuitem id="menu_account_expense_voucher"
              name="Expense Voucher"
              action="action_account_expense_voucher"
              parent="account.menu_finance_entries"
              sequence="55"/>

</odoo>


