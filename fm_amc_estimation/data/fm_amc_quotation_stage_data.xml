<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default FM AMC Quotation Stages -->
        <record id="fm_amc_quotation_stage_draft" model="fm.amc.quotation.stage">
            <field name="name">Draft</field>
            <field name="sequence">10</field>
            <field name="is_default">True</field>
            <field name="is_approved_stage">False</field>
            <field name="is_locked_stage">False</field>
            <field name="active">True</field>
            <field name="fold">False</field>
            <field name="color">1</field>
            <field name="description">Quotation is in draft state and can be modified.</field>
        </record>

        <record id="fm_amc_quotation_stage_sent" model="fm.amc.quotation.stage">
            <field name="name">Sent</field>
            <field name="sequence">20</field>
            <field name="is_default">True</field>
            <field name="is_approved_stage">False</field>
            <field name="is_locked_stage">False</field>
            <field name="active">True</field>
            <field name="fold">False</field>
            <field name="color">3</field>
            <field name="description">Quotation has been sent to the customer.</field>
        </record>

        <record id="fm_amc_quotation_stage_approved" model="fm.amc.quotation.stage">
            <field name="name">Approved</field>
            <field name="sequence">30</field>
            <field name="is_default">True</field>
            <field name="is_approved_stage">True</field>
            <field name="is_locked_stage">False</field>
            <field name="active">True</field>
            <field name="fold">False</field>
            <field name="color">10</field>
            <field name="description">Quotation is approved. Quotation number is generated and contract can be created at this stage.</field>
        </record>

        <record id="fm_amc_quotation_stage_locked" model="fm.amc.quotation.stage">
            <field name="name">Locked</field>
            <field name="sequence">40</field>
            <field name="is_default">True</field>
            <field name="is_approved_stage">False</field>
            <field name="is_locked_stage">True</field>
            <field name="active">True</field>
            <field name="fold">True</field>
            <field name="color">2</field>
            <field name="description">Quotation is locked and cannot be modified.</field>
        </record>
    </data>
</odoo>
