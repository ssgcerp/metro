<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default FM AMC Estimation Stages -->
        <record id="fm_amc_estimation_stage_draft" model="fm.amc.estimation.stage">
            <field name="name">Draft</field>
            <field name="sequence">10</field>
            <field name="is_default">True</field>
            <field name="is_approved_stage">False</field>
            <field name="is_locked_stage">False</field>
            <field name="active">True</field>
            <field name="fold">False</field>
            <field name="color">1</field>
            <field name="description">Estimation is in draft state and can be modified.</field>
        </record>

        <record id="fm_amc_estimation_stage_waiting_approval" model="fm.amc.estimation.stage">
            <field name="name">Waiting Approval</field>
            <field name="sequence">20</field>
            <field name="is_default">True</field>
            <field name="is_approved_stage">False</field>
            <field name="is_locked_stage">False</field>
            <field name="active">True</field>
            <field name="fold">False</field>
            <field name="color">3</field>
            <field name="description">Estimation is submitted for approval. Waiting for approval process.</field>
        </record>

        <record id="fm_amc_estimation_stage_approved" model="fm.amc.estimation.stage">
            <field name="name">Approved</field>
            <field name="sequence">30</field>
            <field name="is_default">True</field>
            <field name="is_approved_stage">True</field>
            <field name="is_locked_stage">False</field>
            <field name="active">True</field>
            <field name="fold">False</field>
            <field name="color">10</field>
            <field name="description">Estimation is approved. Estimation number is generated and quotation can be created at this stage.</field>
        </record>

        <record id="fm_amc_estimation_stage_locked" model="fm.amc.estimation.stage">
            <field name="name">Locked</field>
            <field name="sequence">40</field>
            <field name="is_default">True</field>
            <field name="is_approved_stage">False</field>
            <field name="is_locked_stage">True</field>
            <field name="active">True</field>
            <field name="fold">True</field>
            <field name="color">2</field>
            <field name="description">Estimation is locked and cannot be modified.</field>
        </record>
    </data>
</odoo>



