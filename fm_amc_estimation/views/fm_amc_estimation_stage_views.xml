<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- FM AMC Estimation Stage Form View -->
        <record id="view_fm_amc_estimation_stage_form" model="ir.ui.view">
            <field name="name">fm.amc.estimation.stage.form</field>
            <field name="model">fm.amc.estimation.stage</field>
            <field name="arch" type="xml">
                <form string="Estimation Stage">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="sequence"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="fold"/>
                                <field name="is_default" readonly="1"/>
                                <field name="is_approved_stage"/>
                                <field name="is_locked_stage"/>
                                <field name="color" widget="color_picker"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" placeholder="Description of this stage..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- FM AMC Estimation Stage List View -->
        <record id="view_fm_amc_estimation_stage_tree" model="ir.ui.view">
            <field name="name">fm.amc.estimation.stage.list</field>
            <field name="model">fm.amc.estimation.stage</field>
            <field name="arch" type="xml">
                <list string="Estimation Stages" default_order="sequence">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="is_default"/>
                    <field name="is_approved_stage"/>
                    <field name="is_locked_stage"/>
                    <field name="fold"/>
                    <field name="active" widget="boolean_toggle"/>
                    <field name="color" widget="color_picker"/>
                </list>
            </field>
        </record>

        <!-- FM AMC Estimation Stage Action -->
        <record id="action_fm_amc_estimation_stage" model="ir.actions.act_window">
            <field name="name">Estimation Stages</field>
            <field name="res_model">fm.amc.estimation.stage</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'default_active': True}</field>
        </record>
    </data>
</odoo>


