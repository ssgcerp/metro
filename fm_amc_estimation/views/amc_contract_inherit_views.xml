<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit AMC Contract form view to add Estimations & Sale Orders tabs -->
        <record id="view_amc_contract_form_inherit_estimation" model="ir.ui.view">
            <field name="name">amc.contract.form.inherit.estimation</field>
            <field name="model">amc.contract</field>
            <field name="inherit_id" ref="amc_contracts.view_amc_contract_form"/>
            <field name="arch" type="xml">

                <!-- Insert Estimations and Sale Orders tabs before "Other Info" tab -->
                <page name="other_info" position="before">

                    <!-- ═══════════════════════════════════════════════ -->
                    <!-- TAB: Estimations                                -->
                    <!-- ═══════════════════════════════════════════════ -->
                    <page string="Estimations" name="estimations_tab">
                        <field name="estimation_ids" nolabel="1" readonly="1">
                            <list string="Estimations" create="0" delete="0">
                                <field name="name" string="Estimation Number"/>
                                <field name="estimation_date" string="Estimation Date"/>
                                <field name="partner_id" string="Customer"/>
                                <field name="amount_untaxed" string="Subtotal"/>
                                <field name="amount_tax" string="Tax"/>
                                <field name="amount_total" string="Total"/>
                                <field name="stage_color" column_invisible="1"/>
                                <field name="stage_id" widget="badge" options="{'color_field': 'stage_color'}"/>
                                <field name="sale_order_id" string="Quotation"/>
                            </list>
                        </field>
                    </page>

                    <!-- ═══════════════════════════════════════════════ -->
                    <!-- TAB: Sale Orders                                -->
                    <!-- ═══════════════════════════════════════════════ -->
                    <page string="Sale Orders" name="sale_orders_tab">
                        <field name="contract_sale_order_ids" nolabel="1" readonly="1">
                            <list string="Sale Orders" create="0" delete="0">
                                <field name="name" string="Order Number"/>
                                <field name="date_order" string="Order Date"/>
                                <field name="partner_id" string="Customer"/>
                                <field name="amount_untaxed" string="Untaxed Amount"/>
                                <field name="amount_tax" string="Taxes"/>
                                <field name="amount_total" string="Total"/>
                                <field name="state" widget="badge"
                                       decoration-success="state in ('sale','done')"
                                       decoration-warning="state == 'draft'"
                                       decoration-info="state == 'sent'"
                                       decoration-danger="state == 'cancel'"/>
                            </list>
                        </field>
                    </page>

                    <!-- ═══════════════════════════════════════════════ -->
                    <!-- TAB: Invoices                                   -->
                    <!-- ═══════════════════════════════════════════════ -->
                    <page string="Invoices" name="invoices_tab">
                        <field name="contract_invoice_ids" nolabel="1" readonly="1">
                            <list string="Invoices" create="0" delete="0">
                                <field name="name" string="Invoice Number"/>
                                <field name="invoice_date" string="Invoice Date"/>
                                <field name="partner_id" string="Customer"/>
                                <field name="amount_untaxed_signed" string="Untaxed Amount" optional="hide"/>
                                <field name="amount_tax_signed" string="Tax"/>
                                <field name="amount_total_signed" string="Total"/>
                                <field name="payment_state" widget="badge"
                                       decoration-success="payment_state in ('paid', 'in_payment')"
                                       decoration-warning="payment_state == 'not_paid'"
                                       decoration-info="payment_state == 'partial'"
                                       decoration-danger="payment_state == 'reversed'"/>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'posted'"
                                       decoration-warning="state == 'draft'"
                                       decoration-danger="state == 'cancel'"/>
                            </list>
                        </field>
                    </page>

                </page>
            </field>
        </record>
    </data>
</odoo>
