<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inject AMC Contract and Project into Account Move (Invoice) form -->
        <record id="view_account_move_form_inherit_amc" model="ir.ui.view">
            <field name="name">account.move.form.inherit.amc</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Inject fields into the Other Info -> Invoice group -->
                <xpath expr="//group[@name='sale_info_group']" position="inside">
                    <field name="amc_contract_id" options="{'no_create': True}"/>
                    <field name="project_id" options="{'no_create': True}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
