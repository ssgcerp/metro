<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Product SKU Configuration Form View -->
        <record id="view_fm_amc_product_sku_config_form" model="ir.ui.view">
            <field name="name">fm.amc.product.sku.config.form</field>
            <field name="model">fm.amc.product.sku.config</field>
            <field name="arch" type="xml">
                <form string="Product SKU Configuration">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="active"/>
                            </group>
                        </group>
                        
                        <div class="oe_title">
                            <h1>Product SKU Configuration</h1>
                            <p>Configure how product SKUs are generated.</p>
                        </div>
                        
                        <group>
                            <group>
                                <field name="estimation_sku_prefix" placeholder="e.g., EST-SKU"/>
                                <field name="estimation_sku_next_number" placeholder="Leave empty for auto"/>
                            </group>
                            <group>
                                <field name="default_sku_prefix" placeholder="e.g., SKU"/>
                                <field name="default_sku_next_number" placeholder="Leave empty for auto"/>
                            </group>
                        </group>
                        
                        <group>
                            <group>
                                <field name="sku_separator" placeholder="e.g., -"/>
                                <field name="sku_padding_digits" placeholder="e.g., 6"/>
                            </group>
                        </group>
                        
                        <div class="alert alert-info" role="alert" style="margin-top: 10px;">
                            <strong>SKU Generation:</strong><br/>
                            <ul style="margin-top: 5px;">
                                <li><strong>Estimation SKU:</strong> Used in Estimations and Quotations</li>
                                <li><strong>Default SKU:</strong> Used in Sales Orders and standard product views</li>
                            </ul>
                            <br/>
                            <strong>SKU Format Examples:</strong><br/>
                            <ul style="margin-top: 5px;">
                                <li>Estimation SKU: <code>EST-SKU-000001</code></li>
                                <li>Default SKU: <code>SKU-000001</code></li>
                            </ul>
                            <br/>
                            <strong>How it works:</strong><br/>
                            1. When a product is selected in an estimation or quotation, it displays the <strong>Estimation SKU</strong><br/>
                            2. When converting to a sales order, it switches to the <strong>Default SKU</strong><br/>
                            3. SKUs are automatically generated and guaranteed to be unique<br/>
                            4. You can manually set the "Next Number" fields to control the starting sequence for each SKU type independently
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Product SKU Configuration List View -->
        <record id="view_fm_amc_product_sku_config_tree" model="ir.ui.view">
            <field name="name">fm.amc.product.sku.config.list</field>
            <field name="model">fm.amc.product.sku.config</field>
            <field name="arch" type="xml">
                <list string="Product SKU Configurations">
                    <field name="name"/>
                    <field name="estimation_sku_prefix"/>
                    <field name="default_sku_prefix"/>
                    <field name="sku_padding_digits"/>
                    <field name="estimation_sku_next_number"/>
                    <field name="default_sku_next_number"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Product SKU Configuration Action -->
        <record id="action_fm_amc_product_sku_config" model="ir.actions.act_window">
            <field name="name">Product SKU Configuration</field>
            <field name="res_model">fm.amc.product.sku.config</field>
            <field name="view_mode">list,form</field>
            <field name="limit">1</field>
            <field name="context">{'search_default_active': 1}</field>
        </record>
    </data>
</odoo>

