<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Product Template Form View to Add SKU Fields -->
        <record id="product_template_form_view_inherit" model="ir.ui.view">
            <field name="name">product.template.form.inherit.fm.amc</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <!-- Add Estimation SKU and Default SKU below Track Inventory -->
                <field name="tracking" position="after">
                    <field name="estimation_sku" string="Estimation SKU" readonly="1"/>
                    <field name="default_sku" string="Default SKU" readonly="1"/>
                </field>
            </field>
        </record>
        
        <!-- Inherit Product Template Tree View to Add SKU Columns -->
        <record id="product_template_tree_view_inherit" model="ir.ui.view">
            <field name="name">product.template.tree.inherit.fm.amc</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">
                <field name="default_code" position="after">
                    <field name="estimation_sku" optional="show"/>
                    <field name="default_sku" optional="show"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
