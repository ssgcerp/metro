<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- FM AMC Estimation Line Form View (embedded) -->
        <record id="view_fm_amc_estimation_line_form" model="ir.ui.view">
            <field name="name">fm.amc.estimation.line.form</field>
            <field name="model">fm.amc.estimation.line</field>
            <field name="arch" type="xml">
                <form string="Estimation Line">
                    <sheet>
                        <group>
                            <group>
                                <field name="estimation_id" readonly="1"/>
                                <field name="line_type"/>
                                <field name="product_id" options="{'no_create': True}"/>
                                <field name="product_uom" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="product_uom_qty"/>
                                <field name="price_unit"/>
                                <field name="price_subtotal" readonly="1"/>
                                <field name="tax_id" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="price_tax" readonly="1"/>
                                <field name="price_total" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="name" placeholder="Description of the estimation line..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>



