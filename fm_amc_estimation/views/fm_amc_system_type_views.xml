<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- FM AMC System Type Device List View -->
        <record id="view_fm_amc_system_type_device_tree" model="ir.ui.view">
            <field name="name">fm.amc.system.type.device.list</field>
            <field name="model">fm.amc.system.type.device</field>
            <field name="arch" type="xml">
                <list string="Products">
                    <field name="product_id" string="Products"/>
                    <field name="quantity" string="Quantity"/>
                    <field name="product_uom" string="Unit of Measure"/>
                </list>
            </field>
        </record>

        <!-- FM AMC System Type Form View -->
        <record id="view_fm_amc_system_type_form" model="ir.ui.view">
            <field name="name">fm.amc.system.type.form</field>
            <field name="model">fm.amc.system.type</field>
            <field name="arch" type="xml">
                <form string="AMC System Type">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" placeholder="e.g., FIRE EXTINGUISHERS"/>
                                <field name="number"/>
                            </group>
                            <group>
                                <field name="times"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description" name="description">
                                <group>
                                    <field name="description" placeholder="Enter description..."/>
                                </group>
                            </page>
                            <page string="Devices Required" name="devices_required">
                                <field name="device_ids" nolabel="1">
                                    <list string="Products">
                                        <field name="product_id" string="Products"/>
                                        <field name="quantity" string="Quantity"/>
                                        <field name="product_uom" string="Unit of Measure"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- FM AMC System Type List View -->
        <record id="view_fm_amc_system_type_tree" model="ir.ui.view">
            <field name="name">fm.amc.system.type.list</field>
            <field name="model">fm.amc.system.type</field>
            <field name="arch" type="xml">
                <list string="AMC System Types">
                    <field name="name"/>
                    <field name="number"/>
                    <field name="times"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- FM AMC System Type Search View -->
        <record id="view_fm_amc_system_type_search" model="ir.ui.view">
            <field name="name">fm.amc.system.type.search</field>
            <field name="model">fm.amc.system.type</field>
            <field name="arch" type="xml">
                <search string="AMC System Types">
                    <field name="name" string="Name" filter_domain="['|', ('name', 'ilike', self), ('description', 'ilike', self)]"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <filter string="Times in Year" name="times_in_year" domain="[('times', '=', 'times_in_year')]"/>
                    <filter string="Times in Month" name="times_in_month" domain="[('times', '=', 'times_in_month')]"/>
                    <filter string="Times in Week" name="times_in_week" domain="[('times', '=', 'times_in_week')]"/>
                </search>
            </field>
        </record>

        <!-- FM AMC System Type Action -->
        <record id="action_fm_amc_system_type" model="ir.actions.act_window">
            <field name="name">AMC System Types</field>
            <field name="res_model">fm.amc.system.type</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first AMC System Type!
                </p>
                <p>
                    Define system types for AMC contracts. Each system type can have associated products/devices required for maintenance.
                </p>
            </field>
        </record>
    </data>
</odoo>
