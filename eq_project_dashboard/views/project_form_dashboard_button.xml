<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit project form view to add dashboard button -->
    <!-- In Odoo 19, try project.view_project_project_form or check actual form view ID -->
    <record id="view_project_form_dashboard_button" model="ir.ui.view">
        <field name="name">project.form.dashboard.button</field>
        <field name="model">project.project</field>
        <!-- Common form view IDs in Odoo 19: project.view_project_project_form or project.project_project_view_form -->
        <!-- If these don't work, check Settings > Technical > User Interface > Views and search for project.project form -->
        <field name="inherit_id" ref="project.view_project_project_form"/>
        <field name="arch" type="xml">
            <!-- Add button to button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_project_dashboard"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-bar-chart">
                    <field name="id" invisible="1"/>
                    <div class="o_stat_info">
                        <span class="o_stat_text">Dashboard</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
